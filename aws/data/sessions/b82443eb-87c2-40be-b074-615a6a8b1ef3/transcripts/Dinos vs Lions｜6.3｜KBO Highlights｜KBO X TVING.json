{
  "video_path": "/app/data/sessions/b82443eb-87c2-40be-b074-615a6a8b1ef3/downloads/Dinos vs Lions｜6.3｜KBO Highlights｜KBO X TVING.mp4",
  "language": "ko",
  "duration": 0,
  "segments": [
    {
      "start": 0.0,
      "end": 4.5,
      "text": "오늘 여러분의 소중한 권리를 잘 행사하셨습니까?"
    },
    {
      "start": 4.5,
      "end": 6.62,
      "text": "NC와 삼성의 시즌 8차전 경기입니다."
    },
    {
      "start": 6.62,
      "end": 8.3,
      "text": "너무 말씀해 최연호의 소리가 오겠습니다."
    },
    {
      "start": 8.3,
      "end": 10.44,
      "text": "1번 김주원 2번 이웃성 3번 박민우"
    },
    {
      "start": 10.44,
      "end": 13.3,
      "text": "박민우 선수 오늘 스타팅 이상 없이 출발을 하게 되고요."
    },
    {
      "start": 13.3,
      "end": 15.18,
      "text": "4번 데이비슨 5번 박권우"
    },
    {
      "start": 15.18,
      "end": 18.14,
      "text": "선발로는 이제 최근 2경기 연속에서 등판을 하고 있고"
    },
    {
      "start": 18.14,
      "end": 20.84,
      "text": "오늘 경기가 3경기 연속 선발 등판이 되겠습니다."
    },
    {
      "start": 20.84,
      "end": 24.46,
      "text": "1번 김성현 2번 구조 3번 최용 4번 루인디아"
    },
    {
      "start": 24.46,
      "end": 29.86,
      "text": "5번 박승규 4.7 2회 평균 대책점을 9경기 선발 출전해서 기록하고 있는데"
    },
    {
      "start": 30.16,
      "end": 33.36,
      "text": "2승 2회 1.53의 WHIP"
    },
    {
      "start": 35.76,
      "end": 38.86,
      "text": "최근 2경기 연속 홈런을 때려내고 있는 김주원 선수입니다."
    },
    {
      "start": 43.22,
      "end": 46.26,
      "text": "끌어당깁니다 오른쪽입니다."
    },
    {
      "start": 46.26,
      "end": 49.72,
      "text": "김주원의 3경기 연속 홈런"
    },
    {
      "start": 50.46,
      "end": 55.76,
      "text": "오늘 경기에서도 김주원 선수가 3차전 홈런을 만들어내면서"
    },
    {
      "start": 55.76,
      "end": 59.86,
      "text": "네 NC가 김주원 출발을 오늘 경기에서도 보여줍니다."
    },
    {
      "start": 60.86,
      "end": 63.16,
      "text": "김주원의 시즌 10호 홈런"
    },
    {
      "start": 63.16,
      "end": 68.66,
      "text": "그리고 어제 이어서 오늘도 선도타자 홈런을 때려내고 있는 김주원 1번 타자"
    },
    {
      "start": 68.66,
      "end": 72.76,
      "text": "역시 뭐 가운데로 몰리는 빠른보를 김주원 선수가 놓칠 일은 없죠."
    },
    {
      "start": 72.76,
      "end": 76.46,
      "text": "네 빠른보를 결국에 놓치지 않고 장타로 연결했습니다."
    },
    {
      "start": 77.66,
      "end": 79.86,
      "text": "이웃성의 타구도 높게 좌중간"
    },
    {
      "start": 80.82,
      "end": 83.06,
      "text": "당장 때립니다."
    },
    {
      "start": 83.06,
      "end": 85.06,
      "text": "그리고 타구를 순간 놓쳤고"
    },
    {
      "start": 86.06,
      "end": 87.16,
      "text": "2호까지"
    },
    {
      "start": 87.16,
      "end": 88.86,
      "text": "이웃성의 1호까지"
    },
    {
      "start": 88.86,
      "end": 91.06,
      "text": "2번 타자 이웃성의 1호 타"
    },
    {
      "start": 93.06,
      "end": 96.06,
      "text": "6구 때렸고 떴습니다."
    },
    {
      "start": 96.06,
      "end": 97.36,
      "text": "중변수 김성현"
    },
    {
      "start": 98.06,
      "end": 99.66,
      "text": "가까우면서 잡습니다."
    },
    {
      "start": 100.66,
      "end": 104.66,
      "text": "선무중으로 한 차례 강한 어깨를 뽐내고 있는 김성현"
    },
    {
      "start": 104.66,
      "end": 105.36,
      "text": "원아웃"
    },
    {
      "start": 105.36,
      "end": 108.86,
      "text": "타이밍을 조금 더 빠르게 바꿀 수 있지 않을까 그런 생각이 듭니다."
    },
    {
      "start": 108.86,
      "end": 110.26,
      "text": "타자의 카운트"
    },
    {
      "start": 111.36,
      "end": 112.86,
      "text": "잡아당깁니다 왼쪽입니다."
    },
    {
      "start": 112.86,
      "end": 115.56,
      "text": "좌익수 대시하면서 미끄러지면서 잡습니다."
    },
    {
      "start": 119.26,
      "end": 123.46,
      "text": "아까 먹히는 타구였기 때문에 타구가 지금 생각보다 안 뻗어나갔거든요."
    },
    {
      "start": 123.46,
      "end": 125.26,
      "text": "부장 선수가 그래도"
    },
    {
      "start": 125.26,
      "end": 128.16,
      "text": "떨어지는 타구를 판단을 잘하면서"
    },
    {
      "start": 128.16,
      "end": 130.16,
      "text": "좋은 수비를 보여줬습니다."
    },
    {
      "start": 130.16,
      "end": 132.16,
      "text": "진료가 안 나온 것이 좀 크죠."
    },
    {
      "start": 132.16,
      "end": 132.56,
      "text": "네"
    },
    {
      "start": 132.56,
      "end": 133.96,
      "text": "하이 페이스볼 유도"
    },
    {
      "start": 133.96,
      "end": 134.96,
      "text": "스윙 선진"
    },
    {
      "start": 138.16,
      "end": 139.96,
      "text": "이렇게 인기를 끝내는 최원."
    },
    {
      "start": 142.96,
      "end": 147.76,
      "text": "7번째 공이 낮게 찍혀왔습니다."
    },
    {
      "start": 147.76,
      "end": 151.26,
      "text": "첫 타석부터 출로에 성공하고 있는 김성현 1번 타자"
    },
    {
      "start": 152.76,
      "end": 155.66,
      "text": "투표율 보다 높은 출로위를 기원하는 겁니다."
    },
    {
      "start": 155.66,
      "end": 156.36,
      "text": "오 아주"
    },
    {
      "start": 156.36,
      "end": 158.76,
      "text": "신박한 문구를 써오셨어요."
    },
    {
      "start": 158.76,
      "end": 161.16,
      "text": "잡아당긴 타구입니다 오른쪽"
    },
    {
      "start": 161.16,
      "end": 162.06,
      "text": "한타"
    },
    {
      "start": 163.06,
      "end": 166.46,
      "text": "일로자 김성현 열심히 달려서 3루까지 미끄러져 들어갑니다."
    },
    {
      "start": 166.46,
      "end": 169.46,
      "text": "1, 2, 2번 테이블 세터진이 모두 출로에 성공하고 있습니다."
    },
    {
      "start": 169.46,
      "end": 173.26,
      "text": "향이 타선에 걸리면 코스들은 상당히 고협스러울 것 같습니다."
    },
    {
      "start": 173.26,
      "end": 175.16,
      "text": "초골 당겼는데 이 타구가"
    },
    {
      "start": 175.16,
      "end": 176.26,
      "text": "잡혔고"
    },
    {
      "start": 176.26,
      "end": 177.76,
      "text": "타자줄 잡고"
    },
    {
      "start": 177.76,
      "end": 179.96,
      "text": "맨 앞주자를 끌고 갑니다."
    },
    {
      "start": 179.96,
      "end": 181.36,
      "text": "다 끌고 왔어요."
    },
    {
      "start": 181.36,
      "end": 183.76,
      "text": "런던 상황에서 그대로 택하옵"
    },
    {
      "start": 183.76,
      "end": 186.86,
      "text": "아웃카운트 2개가 한 번에 올라갔습니다."
    },
    {
      "start": 186.86,
      "end": 191.36,
      "text": "네이비스니 김성현을 눈으로 묶고 끝까지 따라오면서"
    },
    {
      "start": 191.36,
      "end": 193.86,
      "text": "결국 아웃카운트 2개가 한 번에 올라갔습니다."
    },
    {
      "start": 193.86,
      "end": 194.36,
      "text": "더블 플래그"
    },
    {
      "start": 194.36,
      "end": 196.36,
      "text": "우성현 선수는 계속 달렸어야 됐나요?"
    },
    {
      "start": 196.36,
      "end": 199.16,
      "text": "아 지금 무사 1삽뇌였기 때문에"
    },
    {
      "start": 200.16,
      "end": 203.16,
      "text": "디아즈의 타구 오른쪽"
    },
    {
      "start": 203.16,
      "end": 204.46,
      "text": "까바르키"
    },
    {
      "start": 204.46,
      "end": 206.46,
      "text": "넘어갑니다."
    },
    {
      "start": 206.46,
      "end": 208.46,
      "text": "오 지금 장이 없는 것 같아요."
    },
    {
      "start": 208.46,
      "end": 210.46,
      "text": "바로 옆전"
    },
    {
      "start": 212.46,
      "end": 214.46,
      "text": "오 지금 완전 대형 업롱이 나왔습니다."
    },
    {
      "start": 214.46,
      "end": 215.46,
      "text": "예"
    },
    {
      "start": 217.46,
      "end": 220.46,
      "text": "루인 디아즈의 시즌 9호 홈런"
    },
    {
      "start": 220.46,
      "end": 227.46,
      "text": "앞선 병살 상황을 입게 하는 역점 토론포"
    },
    {
      "start": 227.46,
      "end": 228.46,
      "text": "2대1"
    },
    {
      "start": 228.46,
      "end": 229.46,
      "text": "삼성 라이언트"
    },
    {
      "start": 229.46,
      "end": 233.46,
      "text": "오랜만에 부른 디아즈다운 타구가 나왔습니다."
    },
    {
      "start": 238.46,
      "end": 239.46,
      "text": "2부"
    },
    {
      "start": 239.46,
      "end": 242.46,
      "text": "땅콜타구와 내야를 가운데로 빠져나갑니다."
    },
    {
      "start": 242.46,
      "end": 244.46,
      "text": "1회 2회 양팀 모두"
    },
    {
      "start": 244.46,
      "end": 248.46,
      "text": "선조타자가 살아나가는 상황이 이어지고 있습니다."
    },
    {
      "start": 249.46,
      "end": 252.46,
      "text": "3런이 너무 임팩트가 되는 홈런이라"
    },
    {
      "start": 252.46,
      "end": 253.46,
      "text": "강한 타구"
    },
    {
      "start": 253.46,
      "end": 254.46,
      "text": "키우는 방"
    },
    {
      "start": 254.46,
      "end": 256.46,
      "text": "잡아놓고 앞선 주자"
    },
    {
      "start": 256.46,
      "end": 257.46,
      "text": "그리고 1루까지"
    },
    {
      "start": 257.46,
      "end": 259.46,
      "text": "더블 플래그"
    },
    {
      "start": 259.46,
      "end": 261.46,
      "text": "김주원의 환상적인 수비"
    },
    {
      "start": 261.46,
      "end": 264.46,
      "text": "지금의 타구가 만약에 안타가 됐다면"
    },
    {
      "start": 264.46,
      "end": 267.46,
      "text": "김태경 선수가 초반에 많이 흔들릴 수 있었거든요."
    },
    {
      "start": 267.46,
      "end": 269.46,
      "text": "상당히 멋있는 수비를 또 만들어 내면서"
    },
    {
      "start": 269.46,
      "end": 272.46,
      "text": "동살탈을 입도로 냈습니다."
    },
    {
      "start": 272.46,
      "end": 274.46,
      "text": "이번에는 어떨지"
    },
    {
      "start": 275.46,
      "end": 276.46,
      "text": "바깥쪽"
    },
    {
      "start": 277.46,
      "end": 278.46,
      "text": "바깥쪽"
    },
    {
      "start": 278.46,
      "end": 279.46,
      "text": "루킹삼진"
    },
    {
      "start": 279.46,
      "end": 283.46,
      "text": "세타자로 끝나는 삼성 라이언트 2회 말이었습니다."
    },
    {
      "start": 285.46,
      "end": 288.46,
      "text": "성장을 하려면 초반에 실점을 하더라도"
    },
    {
      "start": 288.46,
      "end": 293.46,
      "text": "대량 실점을 피하면서 꾸준히 인닝을 끌어주는 역할도 중요하거든요."
    },
    {
      "start": 293.46,
      "end": 295.46,
      "text": "김성인의 왼쪽에 안타"
    },
    {
      "start": 295.46,
      "end": 300.46,
      "text": "우주꽃까지 날려달라는 한 소녀의 바람이 있습니다."
    },
    {
      "start": 302.46,
      "end": 305.46,
      "text": "멈쩡한 볼 뒤로 튀었고"
    },
    {
      "start": 305.46,
      "end": 308.46,
      "text": "김성인이 이 사이에 한 베이스를 넣었습니다."
    },
    {
      "start": 309.46,
      "end": 311.46,
      "text": "나이 페이스볼 유도"
    },
    {
      "start": 311.46,
      "end": 314.46,
      "text": "그대로 당기면서 오른쪽 높게"
    },
    {
      "start": 314.46,
      "end": 315.46,
      "text": "탐장"
    },
    {
      "start": 315.46,
      "end": 318.46,
      "text": "넘어갑니다."
    },
    {
      "start": 319.46,
      "end": 322.46,
      "text": "루앤디아's 연타서 커브런."
    },
    {
      "start": 324.46,
      "end": 327.46,
      "text": "아 지금은 김영준 폰수가 요구하는 대로"
    },
    {
      "start": 327.46,
      "end": 331.46,
      "text": "바깥쪽 하이 페이스볼을 김태경 선수가 투구를 했거든요."
    },
    {
      "start": 331.46,
      "end": 333.46,
      "text": "근데 그 높게 오는 페이스볼을"
    },
    {
      "start": 333.46,
      "end": 336.46,
      "text": "기아주 선수가 약간 다음 물로 수잉을 가져가면서"
    },
    {
      "start": 336.46,
      "end": 338.46,
      "text": "홈런을 또 만들어냈습니다."
    },
    {
      "start": 338.46,
      "end": 340.46,
      "text": "이러면 어디에 던집니까?"
    },
    {
      "start": 340.46,
      "end": 342.46,
      "text": "이러면 골라야죠."
    },
    {
      "start": 345.46,
      "end": 347.46,
      "text": "루앤디아's의"
    },
    {
      "start": 348.46,
      "end": 350.46,
      "text": "시즌 10호 홈런."
    },
    {
      "start": 354.46,
      "end": 356.46,
      "text": "아까쪽 조금 빠져앉은 강미롭고"
    },
    {
      "start": 356.46,
      "end": 359.46,
      "text": "지금도 팔기를 늘리면서 때렸고"
    },
    {
      "start": 359.46,
      "end": 361.46,
      "text": "오른쪽에 안타가 됩니다."
    },
    {
      "start": 361.46,
      "end": 365.46,
      "text": "어제도 비슷한 바깥쪽 볼성의 슬라이더를"
    },
    {
      "start": 365.46,
      "end": 367.46,
      "text": "센터 앞에 안타를 쳤는데"
    },
    {
      "start": 367.46,
      "end": 369.46,
      "text": "2번 1스프라이."
    },
    {
      "start": 370.46,
      "end": 372.46,
      "text": "박민우가 오늘 2탄수 무한타 기록하고 있는데"
    },
    {
      "start": 372.46,
      "end": 374.46,
      "text": "오른쪽에 빨래쭈 같은 타구가"
    },
    {
      "start": 374.46,
      "end": 377.46,
      "text": "탐장을 넘어갑니다."
    },
    {
      "start": 378.46,
      "end": 380.46,
      "text": "박민우의 투로 넘는."
    },
    {
      "start": 380.46,
      "end": 383.46,
      "text": "역시 NC의 간판타자의 박민우 선수가"
    },
    {
      "start": 383.46,
      "end": 385.46,
      "text": "정말 중요한 상황에서"
    },
    {
      "start": 385.46,
      "end": 388.46,
      "text": "또 투로 넘는 걸 만들어냈습니다."
    },
    {
      "start": 389.46,
      "end": 391.46,
      "text": "시즌 3호"
    },
    {
      "start": 395.46,
      "end": 397.46,
      "text": "한점차"
    },
    {
      "start": 397.46,
      "end": 399.46,
      "text": "따라 붙고 있는 NC 다이너스."
    },
    {
      "start": 403.46,
      "end": 405.46,
      "text": "이번에도 빨래쭈 같은 타구였습니다."
    },
    {
      "start": 405.46,
      "end": 408.46,
      "text": "오른쪽에 빨래쭈 하나 걸었어요."
    },
    {
      "start": 411.46,
      "end": 412.46,
      "text": "땅볼."
    },
    {
      "start": 412.46,
      "end": 414.46,
      "text": "육역수 백헌드 먼걸인데"
    },
    {
      "start": 414.46,
      "end": 416.46,
      "text": "바운송구."
    },
    {
      "start": 416.46,
      "end": 418.46,
      "text": "시즌."
    },
    {
      "start": 418.46,
      "end": 420.46,
      "text": "의도적인 바운송구."
    },
    {
      "start": 420.46,
      "end": 423.46,
      "text": "그러니까 이제 의도적인 바운송구를"
    },
    {
      "start": 423.46,
      "end": 425.46,
      "text": "하려다 보니까 너무 앞에 바운드가"
    },
    {
      "start": 425.46,
      "end": 427.46,
      "text": "발생되면서 2바운드가 됐어요."
    },
    {
      "start": 427.46,
      "end": 428.46,
      "text": "네."
    },
    {
      "start": 428.46,
      "end": 430.46,
      "text": "세 번째 타서."
    },
    {
      "start": 431.46,
      "end": 432.46,
      "text": "박건우의 타구."
    },
    {
      "start": 432.46,
      "end": 433.46,
      "text": "센터 쪽."
    },
    {
      "start": 433.46,
      "end": 435.46,
      "text": "중견수 달립니다."
    },
    {
      "start": 435.46,
      "end": 436.46,
      "text": "잡았습니다."
    },
    {
      "start": 436.46,
      "end": 437.46,
      "text": "1아웃."
    },
    {
      "start": 437.46,
      "end": 439.46,
      "text": "잘 맞은 타구를 김석인 선수가"
    },
    {
      "start": 439.46,
      "end": 441.46,
      "text": "끝까지 쫓아가서 펜스 앞에서"
    },
    {
      "start": 441.46,
      "end": 443.46,
      "text": "좋은 폭우를 보여줬습니다."
    },
    {
      "start": 443.46,
      "end": 445.46,
      "text": "최헌태가."
    },
    {
      "start": 445.46,
      "end": 447.46,
      "text": "오늘의 인물을 끝내입니다."
    },
    {
      "start": 447.46,
      "end": 449.46,
      "text": "27경기 삼승 1파 6홀 대."
    },
    {
      "start": 449.46,
      "end": 451.46,
      "text": "3.10의 평균자 측점."
    },
    {
      "start": 451.46,
      "end": 453.46,
      "text": "W2차의 피가 1.82."
    },
    {
      "start": 453.46,
      "end": 455.46,
      "text": "어떤 타격을 보여줄지."
    },
    {
      "start": 456.46,
      "end": 457.46,
      "text": "4국."
    },
    {
      "start": 457.46,
      "end": 459.46,
      "text": "마운드요 빠진 안 나가면서"
    },
    {
      "start": 459.46,
      "end": 460.46,
      "text": "중견수 앞까지."
    },
    {
      "start": 460.46,
      "end": 461.46,
      "text": "공은 구릅니다."
    },
    {
      "start": 461.46,
      "end": 462.46,
      "text": "안타."
    },
    {
      "start": 462.46,
      "end": 464.46,
      "text": "바운송구에 대한 대응이"
    },
    {
      "start": 464.46,
      "end": 466.46,
      "text": "우정환 선수가 좋네요."
    },
    {
      "start": 469.46,
      "end": 470.46,
      "text": "땅볼."
    },
    {
      "start": 470.46,
      "end": 471.46,
      "text": "3로수 잡고."
    },
    {
      "start": 471.46,
      "end": 473.46,
      "text": "가까운 베이스 찍고."
    },
    {
      "start": 473.46,
      "end": 475.46,
      "text": "1루까지 이어집니다."
    },
    {
      "start": 475.46,
      "end": 477.46,
      "text": "경살 타로 인인은 이렇게"
    },
    {
      "start": 477.46,
      "end": 478.46,
      "text": "종료되고 있습니다."
    },
    {
      "start": 481.46,
      "end": 484.46,
      "text": "7경기 1승 1파 1.78의 W2차 IP."
    },
    {
      "start": 484.46,
      "end": 486.46,
      "text": "부인닝 동안 4사구가 13개였습니다."
    },
    {
      "start": 489.46,
      "end": 492.46,
      "text": "4구 몸적권 스윙 3진입니다."
    },
    {
      "start": 492.46,
      "end": 494.46,
      "text": "휘두르면서 몸적 변화구에"
    },
    {
      "start": 494.46,
      "end": 496.46,
      "text": "반응했는데 스윙 3진으로 원아웃."
    },
    {
      "start": 496.46,
      "end": 499.46,
      "text": "슬라이더가 각도 조금 있거든요."
    },
    {
      "start": 500.46,
      "end": 501.46,
      "text": "박승규."
    },
    {
      "start": 501.46,
      "end": 503.46,
      "text": "초부에 대한 떴습니다."
    },
    {
      "start": 504.46,
      "end": 506.46,
      "text": "오른쪽 덮고 우익수."
    },
    {
      "start": 506.46,
      "end": 508.46,
      "text": "보장환이 잡았습니다."
    },
    {
      "start": 508.46,
      "end": 509.46,
      "text": "2아웃."
    },
    {
      "start": 513.46,
      "end": 514.46,
      "text": "변화구 스윙 3진."
    },
    {
      "start": 517.46,
      "end": 519.46,
      "text": "박민우의 호흡론으로 치열함을 되찾은"
    },
    {
      "start": 519.46,
      "end": 520.46,
      "text": "오늘 경기."
    },
    {
      "start": 520.46,
      "end": 521.46,
      "text": "신영호가 3잡아온"
    },
    {
      "start": 521.46,
      "end": 523.46,
      "text": "휘두르면서 몸적권 스윙 3진."
    },
    {
      "start": 525.46,
      "end": 527.46,
      "text": "25경기 8홀드 있습니다."
    },
    {
      "start": 527.46,
      "end": 529.46,
      "text": "평균자 측점은 1.73."
    },
    {
      "start": 529.46,
      "end": 531.46,
      "text": "W2차 IP는 1.27."
    },
    {
      "start": 531.46,
      "end": 533.46,
      "text": "두 번 타자 서우철의 볼레출로."
    },
    {
      "start": 533.46,
      "end": 536.46,
      "text": "그리고 서우철 선수가 대주자 교체되고 있습니다."
    },
    {
      "start": 539.46,
      "end": 541.46,
      "text": "주자 스타트를 끊는 척했고."
    },
    {
      "start": 541.46,
      "end": 544.46,
      "text": "우익수 도전 타봤어요."
    },
    {
      "start": 544.46,
      "end": 546.46,
      "text": "박승규 슈퍼캐치."
    },
    {
      "start": 546.46,
      "end": 548.46,
      "text": "이스비는 되게 크네요."
    },
    {
      "start": 548.46,
      "end": 551.46,
      "text": "저게 만약에 빠졌다면"
    },
    {
      "start": 551.46,
      "end": 556.46,
      "text": "거의 1루 주자는 호흡 동점을 하는 거고."
    },
    {
      "start": 556.46,
      "end": 559.46,
      "text": "타자 주자도 3루까지 갈 수 있는 타고였거든요."
    },
    {
      "start": 559.46,
      "end": 562.46,
      "text": "삼성라이언스는 투수를 2제이선 선수로 교체했습니다."
    },
    {
      "start": 562.46,
      "end": 565.46,
      "text": "다음이 또 이웃성부터 시작할 수 있으니까요."
    },
    {
      "start": 565.46,
      "end": 566.46,
      "text": "갔어요."
    },
    {
      "start": 566.46,
      "end": 568.46,
      "text": "뛰었고 쏩니다."
    },
    {
      "start": 568.46,
      "end": 569.46,
      "text": "이렇게."
    },
    {
      "start": 569.46,
      "end": 572.46,
      "text": "스타트가 상당히 좋았습니다."
    },
    {
      "start": 572.46,
      "end": 577.46,
      "text": "3경기 나와서 짧은 인닝으로 소화를 하고 있는데."
    },
    {
      "start": 577.46,
      "end": 579.46,
      "text": "볼 뒤로 블르른 사이에 이렇게."
    },
    {
      "start": 579.46,
      "end": 583.46,
      "text": "한 베이스를 더 얻어내고 있는 최정환."
    },
    {
      "start": 583.46,
      "end": 589.46,
      "text": "그리고 타자 주자 이웃성 선수는 볼을 했으러 1루에 나갑니다."
    },
    {
      "start": 589.46,
      "end": 592.46,
      "text": "2루는 몸점 높게 설정 끌어 당긴 타고."
    },
    {
      "start": 592.46,
      "end": 593.46,
      "text": "깊은 타고."
    },
    {
      "start": 593.46,
      "end": 594.46,
      "text": "이루스 접고."
    },
    {
      "start": 594.46,
      "end": 596.46,
      "text": "1루에."
    },
    {
      "start": 596.46,
      "end": 597.46,
      "text": "아웃."
    },
    {
      "start": 597.46,
      "end": 602.46,
      "text": "아웃입니다."
    },
    {
      "start": 602.46,
      "end": 606.46,
      "text": "이번 인닝 박승규와 양우현이."
    },
    {
      "start": 606.46,
      "end": 610.46,
      "text": "팀을 무실점 인닝으로 이끌어갑니다."
    },
    {
      "start": 610.46,
      "end": 622.46,
      "text": "라이언스 박입니다."
    },
    {
      "start": 622.46,
      "end": 626.46,
      "text": "강유려 선수가 앞서 이제 대주자 교체가 됐는데."
    },
    {
      "start": 626.46,
      "end": 629.46,
      "text": "장승연 보스로 교체가 됐습니다."
    },
    {
      "start": 629.46,
      "end": 633.46,
      "text": "그리고 앞서 대주자 나왔던 김상준이 이루스로."
    },
    {
      "start": 633.46,
      "end": 634.46,
      "text": "오."
    },
    {
      "start": 634.46,
      "end": 637.46,
      "text": "데이비슨 못 맞는 볼출로."
    },
    {
      "start": 637.46,
      "end": 639.46,
      "text": "데이비슨이 대주자도."
    },
    {
      "start": 639.46,
      "end": 645.46,
      "text": "대주자 한석현."
    },
    {
      "start": 645.46,
      "end": 647.46,
      "text": "잡아던 김타와 3유간 열었어요."
    },
    {
      "start": 647.46,
      "end": 648.46,
      "text": "왼쪽의 한타."
    },
    {
      "start": 648.46,
      "end": 651.46,
      "text": "주자 2명 배치."
    },
    {
      "start": 651.46,
      "end": 658.46,
      "text": "자, 앤시가 또 역전주자까지 나아가면서 노하우스의 좋은 찬스를 연결하고 있네요."
    },
    {
      "start": 658.46,
      "end": 661.46,
      "text": "8회 앤시가 삼성을 다시 암박해 들어갑니다."
    },
    {
      "start": 661.46,
      "end": 663.46,
      "text": "19경기 1승."
    },
    {
      "start": 663.46,
      "end": 664.46,
      "text": "1세이브 4홀."
    },
    {
      "start": 664.46,
      "end": 666.46,
      "text": "5.19의 강릉자."
    },
    {
      "start": 666.46,
      "end": 668.46,
      "text": "1.62의 WHIP."
    },
    {
      "start": 668.46,
      "end": 673.46,
      "text": "스트라이드를 하지 않으면서 지금 탁역을 하고 있어요."
    },
    {
      "start": 673.46,
      "end": 674.46,
      "text": "끌어당긴 타구입니다."
    },
    {
      "start": 674.46,
      "end": 675.46,
      "text": "오른쪽."
    },
    {
      "start": 675.46,
      "end": 676.46,
      "text": "우익수."
    },
    {
      "start": 676.46,
      "end": 677.46,
      "text": "거의 제자리 잡고."
    },
    {
      "start": 677.46,
      "end": 680.46,
      "text": "2루자 탭업해서 3루까지 미끄러져 들어갑니다."
    },
    {
      "start": 680.46,
      "end": 681.46,
      "text": "베타."
    },
    {
      "start": 681.46,
      "end": 683.46,
      "text": "권희동 선수가 5으로 들어옵니다."
    },
    {
      "start": 683.46,
      "end": 688.46,
      "text": "높은 공의 베트가 나오면서 팟플라이가 뜰 수가 있거든요."
    },
    {
      "start": 688.46,
      "end": 689.46,
      "text": "땅뽀."
    },
    {
      "start": 689.46,
      "end": 690.46,
      "text": "6격수."
    },
    {
      "start": 690.46,
      "end": 693.46,
      "text": "잡아서 타자준 선택 3루주자 득점."
    },
    {
      "start": 693.46,
      "end": 695.46,
      "text": "4대 3루 득점."
    },
    {
      "start": 695.46,
      "end": 699.46,
      "text": "여기서 이웃중 감독이 또 작전을 거네요."
    },
    {
      "start": 699.46,
      "end": 700.46,
      "text": "비텐드런 작전."
    },
    {
      "start": 700.46,
      "end": 707.46,
      "text": "아무래도 권희동 선수이다 보니까 비텐드런 작전을 걸면서 동점에 성공을 했습니다."
    },
    {
      "start": 707.46,
      "end": 712.46,
      "text": "여전히 득점권의 주자가 남아있고 오늘 안타가 있는 박시원 8번 타자."
    },
    {
      "start": 712.46,
      "end": 715.46,
      "text": "상대로 높은전 스윙 3진."
    },
    {
      "start": 715.46,
      "end": 719.46,
      "text": "1윙은 이렇게 마무리 되고 있습니다."
    },
    {
      "start": 719.46,
      "end": 723.46,
      "text": "스코어는 4대 3루 동점."
    },
    {
      "start": 723.46,
      "end": 732.46,
      "text": "결국에 재구나 타자의 노림수나 여러 가지를 감안하면 변하고 돌 확률 높아요."
    },
    {
      "start": 732.46,
      "end": 734.46,
      "text": "6구 변하고 참치 못합니다."
    },
    {
      "start": 734.46,
      "end": 735.46,
      "text": "스윙 3진."
    },
    {
      "start": 735.46,
      "end": 738.46,
      "text": "3타자의 거의 패턴이 비슷해요 지금."
    },
    {
      "start": 738.46,
      "end": 742.46,
      "text": "홀베아비."
    },
    {
      "start": 742.46,
      "end": 744.46,
      "text": "끌어난긴 타구입니다."
    },
    {
      "start": 744.46,
      "end": 746.46,
      "text": "오른쪽."
    },
    {
      "start": 746.46,
      "end": 748.46,
      "text": "파울이에요."
    },
    {
      "start": 748.46,
      "end": 753.46,
      "text": "스코어 3진."
    },
    {
      "start": 753.46,
      "end": 756.46,
      "text": "맥없이 배트가 끌려 나왔습니다."
    },
    {
      "start": 756.46,
      "end": 762.46,
      "text": "파울 홈런 다음에는 상지들하고 이렇게 2윙은 마무리 되고 있습니다."
    },
    {
      "start": 762.46,
      "end": 769.46,
      "text": "진영과 아웃카운트 9개를 처리하고 있습니다."
    },
    {
      "start": 770.46,
      "end": 772.46,
      "text": "오늘 넓게 쓰자는."
    },
    {
      "start": 772.46,
      "end": 777.46,
      "text": "제스처를 취했는데 결국 이 타구가 좌중간에 안타가 됐습니다."
    },
    {
      "start": 777.46,
      "end": 778.46,
      "text": "2로 노립니다."
    },
    {
      "start": 778.46,
      "end": 779.46,
      "text": "2로까지."
    },
    {
      "start": 779.46,
      "end": 780.46,
      "text": "보기루해."
    },
    {
      "start": 780.46,
      "end": 782.46,
      "text": "세임."
    },
    {
      "start": 782.46,
      "end": 786.46,
      "text": "네."
    },
    {
      "start": 786.46,
      "end": 792.46,
      "text": "엉덩이 빠지면서 때린 타구인데 투수 흘려 보내고 던질 곳이 없었어요."
    },
    {
      "start": 792.46,
      "end": 793.46,
      "text": "던질 곳이 없었습니다."
    },
    {
      "start": 793.46,
      "end": 797.46,
      "text": "마운드도 파턴 타고 주자 3로 하일로 양코너."
    },
    {
      "start": 797.46,
      "end": 800.46,
      "text": "여기서 또 엔시가 해군의 내 안타가 나옵니다."
    },
    {
      "start": 800.46,
      "end": 806.46,
      "text": "이우성 내 안타 오늘 4번째 출로 3화타 경기 치르고 있는 이우성 선수입니다."
    },
    {
      "start": 806.46,
      "end": 813.46,
      "text": "박윤우 선수를 베이스를 내주면서 말로를 채운 거 안중열 선수를 상대하겠습니다."
    },
    {
      "start": 816.46,
      "end": 822.46,
      "text": "7번 징업 스윙 3진."
    },
    {
      "start": 822.46,
      "end": 825.46,
      "text": "이우성 선수의 코너에서 빠져나오고 있는 최지광 선수입니다."
    },
    {
      "start": 825.46,
      "end": 826.46,
      "text": "투아웃."
    },
    {
      "start": 826.46,
      "end": 831.46,
      "text": "시즌 13세임 어제 기록했던 김재윤 1.07에 WHIP."
    },
    {
      "start": 834.46,
      "end": 838.46,
      "text": "초부 변화구 스트라이크."
    },
    {
      "start": 838.46,
      "end": 841.46,
      "text": "3구 변화구 스트라이크."
    },
    {
      "start": 841.46,
      "end": 842.46,
      "text": "네."
    },
    {
      "start": 842.46,
      "end": 849.46,
      "text": "지금 두개 카운트 잡는 모든 슬라이더들이 코스가 상당히 좋게 들어가고 있습니다."
    },
    {
      "start": 849.46,
      "end": 850.46,
      "text": "네."
    },
    {
      "start": 851.46,
      "end": 853.46,
      "text": "2번 1."
    },
    {
      "start": 855.46,
      "end": 858.46,
      "text": "8번 짜봉 3진."
    },
    {
      "start": 858.46,
      "end": 859.46,
      "text": "3진."
    },
    {
      "start": 859.46,
      "end": 861.46,
      "text": "찰루 룸발루."
    },
    {
      "start": 867.46,
      "end": 871.46,
      "text": "아쉬움에 잠시 자리를 뜨지 못했던 박권우."
    },
    {
      "start": 871.46,
      "end": 878.46,
      "text": "전삼이 선수도 뭐 크게 벗어나는 것만 사실은 통제와 가능하다면 정말"
    },
    {
      "start": 878.46,
      "end": 880.46,
      "text": "이력적인 뜻이거든요."
    },
    {
      "start": 880.46,
      "end": 881.46,
      "text": "네."
    },
    {
      "start": 881.46,
      "end": 883.46,
      "text": "못 맞는 볼."
    },
    {
      "start": 883.46,
      "end": 886.46,
      "text": "네 슬라이더가 빠졌어요."
    },
    {
      "start": 886.46,
      "end": 887.46,
      "text": "지금."
    },
    {
      "start": 887.46,
      "end": 890.46,
      "text": "2에서 이렇게 못 맞는 볼을 허용을 하고 있습니다."
    },
    {
      "start": 890.46,
      "end": 892.46,
      "text": "원하우트 자일로가 되겠습니다."
    },
    {
      "start": 892.46,
      "end": 900.46,
      "text": "대주자로는 박해범 선수가 나갔고 그리고 타석에는 류지혁 선수가 들어오고 있습니다."
    },
    {
      "start": 901.46,
      "end": 904.46,
      "text": "토토에서 밀어보낸 타구와 라인드라이버."
    },
    {
      "start": 907.46,
      "end": 911.46,
      "text": "일단 포구 인정이 되면서 아웃카운트랑 하나."
    },
    {
      "start": 914.46,
      "end": 916.46,
      "text": "이재현의 타구 왼쪽."
    },
    {
      "start": 916.46,
      "end": 918.46,
      "text": "자육수 빨아가서 잡았습니다."
    },
    {
      "start": 922.46,
      "end": 928.46,
      "text": "이 경기 양패 27개의 아웃카운트로는 순유를 가리지 못했습니다."
    },
    {
      "start": 931.46,
      "end": 934.46,
      "text": "매구 기합과 함께 던지고 있는 김재현 선수입니다."
    },
    {
      "start": 935.46,
      "end": 936.46,
      "text": "원, 투."
    },
    {
      "start": 937.46,
      "end": 938.46,
      "text": "승장진."
    },
    {
      "start": 938.46,
      "end": 943.46,
      "text": "결국은 끝까지 바깥쪽 하이페이스보를 투구하면서 허수윙을 만들어냈는데."
    },
    {
      "start": 946.46,
      "end": 947.46,
      "text": "자극."
    },
    {
      "start": 947.46,
      "end": 949.46,
      "text": "좌중간을 향하는 타구입니다."
    },
    {
      "start": 949.46,
      "end": 950.46,
      "text": "좌중간에 빠집니다."
    },
    {
      "start": 950.46,
      "end": 951.46,
      "text": "호태훈."
    },
    {
      "start": 951.46,
      "end": 952.46,
      "text": "두 베이스 노립니다."
    },
    {
      "start": 952.46,
      "end": 953.46,
      "text": "1위까지."
    },
    {
      "start": 953.46,
      "end": 955.46,
      "text": "2위까지 서서 도착."
    },
    {
      "start": 957.46,
      "end": 959.46,
      "text": "호태훈이 득점권 주자가 되었습니다."
    },
    {
      "start": 961.46,
      "end": 965.46,
      "text": "3구 변화구를 때려내면서 중교차 변타."
    },
    {
      "start": 966.46,
      "end": 970.46,
      "text": "짧은 안타였고 호태훈은 3룰 돌지 못했습니다."
    },
    {
      "start": 971.46,
      "end": 972.46,
      "text": "김한별 9번 타자."
    },
    {
      "start": 975.46,
      "end": 976.46,
      "text": "아예 높게."
    },
    {
      "start": 976.46,
      "end": 977.46,
      "text": "주자가 가는데."
    },
    {
      "start": 977.46,
      "end": 980.46,
      "text": "윗도 동작밖에 취할 수가 없습니다."
    },
    {
      "start": 981.46,
      "end": 982.46,
      "text": "1, 4, 3, 2루."
    },
    {
      "start": 983.46,
      "end": 985.46,
      "text": "전진수비 선택한 삼성 라이언스."
    },
    {
      "start": 986.46,
      "end": 989.46,
      "text": "밀어내면서 오른쪽 안탑니다."
    },
    {
      "start": 989.46,
      "end": 993.46,
      "text": "3루 주자 득점 역전에 성공하고 있는 시다이노스."
    },
    {
      "start": 994.46,
      "end": 1001.46,
      "text": "아, 지금 A씨가 이 뒤에 들어간 타자들이 경기 방판에 너무나 좋은 타격을 보여주네요."
    },
    {
      "start": 1001.46,
      "end": 1002.46,
      "text": "네."
    },
    {
      "start": 1003.46,
      "end": 1008.46,
      "text": "꾸준히 두드리면서 결국 역전까지 만들어내고 있는 시다이노스입니다."
    },
    {
      "start": 1009.46,
      "end": 1011.46,
      "text": "이승현 선수가 7무대로 돌아왔습니다."
    },
    {
      "start": 1012.46,
      "end": 1014.46,
      "text": "호라도 선수가 오늘 말소가 됐고요."
    },
    {
      "start": 1014.46,
      "end": 1015.46,
      "text": "호매턴."
    },
    {
      "start": 1017.46,
      "end": 1018.46,
      "text": "변화하고 자, 마치 했고."
    },
    {
      "start": 1019.46,
      "end": 1020.46,
      "text": "일로써 자, 마소 베이스 받고."
    },
    {
      "start": 1020.46,
      "end": 1021.46,
      "text": "호매선."
    },
    {
      "start": 1021.46,
      "end": 1022.46,
      "text": "호매선, 세임."
    },
    {
      "start": 1022.46,
      "end": 1023.46,
      "text": "호매선, 세임."
    },
    {
      "start": 1024.46,
      "end": 1026.46,
      "text": "일단 타자 주자라 1, 2, 4, 9시고요."
    },
    {
      "start": 1029.46,
      "end": 1032.46,
      "text": "손이 떴다 가라앉는 지점이 있는데."
    },
    {
      "start": 1033.46,
      "end": 1034.46,
      "text": "세임."
    },
    {
      "start": 1034.46,
      "end": 1035.46,
      "text": "그대로 원심 유지."
    },
    {
      "start": 1035.46,
      "end": 1042.46,
      "text": "박시현 선수의 또 좋은 슬라이딩이 추가 득점에 성공을 했고요."
    },
    {
      "start": 1042.46,
      "end": 1045.46,
      "text": "또 반대로 장수현 포즈의 티드가 좀 돌아다갔어요."
    },
    {
      "start": 1048.46,
      "end": 1049.46,
      "text": "23경기."
    },
    {
      "start": 1049.46,
      "end": 1057.46,
      "text": "만약에 오늘 경기를 이 상태로 흔들 수 있다면 승기 상태로 흔들 수 있다면 김지로 선수는 시즌 첫 세임을 액그룩할 수 있습니다."
    },
    {
      "start": 1061.46,
      "end": 1063.46,
      "text": "볼 4개가 연속 캐스트로입니다."
    },
    {
      "start": 1067.46,
      "end": 1071.46,
      "text": "3구째 피들러봤는데 빗맞으면서 떳고 3명의 아수 모입니다."
    },
    {
      "start": 1071.46,
      "end": 1074.46,
      "text": "유격수 김주원 잇따라 잡았습니다."
    },
    {
      "start": 1075.46,
      "end": 1078.46,
      "text": "네트풀처였는데 이공을 잡습니다."
    },
    {
      "start": 1082.46,
      "end": 1083.46,
      "text": "그럼 당긴 타구입니다."
    },
    {
      "start": 1083.46,
      "end": 1086.46,
      "text": "이루수 잡아서 구자욱 선택."
    },
    {
      "start": 1086.46,
      "end": 1093.46,
      "text": "역시 뭐 2점 차로 앞서 있기 때문에 박민우 선수가 조금 더 안전한 선택을 할 수 있었습니다."
    },
    {
      "start": 1097.46,
      "end": 1098.46,
      "text": "볼렛이에요."
    },
    {
      "start": 1099.46,
      "end": 1102.46,
      "text": "이 찬스가 또 디라즈 선수까지 연결이 되네요."
    },
    {
      "start": 1107.46,
      "end": 1110.46,
      "text": "낮은 공을 건드렸고 떠오른 타구입니다."
    },
    {
      "start": 1110.46,
      "end": 1111.46,
      "text": "좌익수."
    },
    {
      "start": 1111.46,
      "end": 1112.46,
      "text": "유격수."
    },
    {
      "start": 1112.46,
      "end": 1120.46,
      "text": "유격수 멈춰주고 좌익수 잡아내면서 이렇게 앤시다이노스가 역전승으로 삼성 라이언스 상대 첫 승을 기록합니다."
    },
    {
      "start": 1122.46,
      "end": 1124.46,
      "text": "치열했던 승부 스쿤 6대4."
    },
    {
      "start": 1124.46,
      "end": 1132.46,
      "text": "아시다이노스가 성성 상대 7연팩 끝에 오늘 첫 승을 기록했습니다."
    }
  ]
}