{
  "video_path": "/app/data/sessions/80fd585c-dd9c-4a49-ab1b-e37c037351c5/downloads/역전극 끝 5선 오세훈 ＂시민의 위대한 승리＂.mp4",
  "language": "ko",
  "duration": 856.189375,
  "segments": [
    {
      "start": 19.79,
      "end": 26.3,
      "text": "서울 시민의 삶의 지대도 밝은 청신호가 켜졌습니다."
    },
    {
      "start": 26.3,
      "end": 33.58,
      "text": "이번 선거의 결과는 저 오세훈 개인의 대층 이동 사다리가 끊겨서 좌절하면서도"
    },
    {
      "start": 33.58,
      "end": 40.06,
      "text": "다시 한 번 공정하고 희망찬 미래를 꿈꾸는 지옥가도 같은 전 월세난이"
    },
    {
      "start": 40.06,
      "end": 46.45,
      "text": "끝나기를 바라는 서비운도 아이를 안심하고 막힐 꽃을 찾는 막본"
    },
    {
      "start": 46.45,
      "end": 50.45,
      "text": "아까도 같은 전 월세난이 끝나기를 바라는 서비연들."
    },
    {
      "start": 50.45,
      "end": 55.87,
      "text": "아이를 안심하고 맡길 곳을 찾는 맛보리 부부들에서 희망을 기다려온 주민들."
    },
    {
      "start": 55.87,
      "end": 60.89,
      "text": "이 평범하고 성실한 시민들의 승리라고 생각합니다."
    },
    {
      "start": 60.89,
      "end": 66.78,
      "text": "서울의 골목상권이 한륙을 전하는 어르신들의 승리입니다."
    },
    {
      "start": 66.78,
      "end": 73.54,
      "text": "견제와 균형이라는 민주주의의 대원 측을 다시 한 번 확보하게 세워주셨습니다."
    },
    {
      "start": 73.54,
      "end": 79.78,
      "text": "대한민국이 한쪽으로 완전히 기울어지지않아 안전판으로 남겨주셨습니다."
    },
    {
      "start": 79.78,
      "end": 86.62,
      "text": "그 없던 권력, 그 없던 정권도 국민의 설수 없다는 사실은 시민입니다."
    },
    {
      "start": 86.62,
      "end": 92.46,
      "text": "서울의 이름으로 민주주의 균형을 벌어라 시민 여러분."
    },
    {
      "start": 92.46,
      "end": 97.02,
      "text": "민주주의는 별가만큼이나 과정 또한 중요합니다."
    },
    {
      "start": 97.02,
      "end": 103.6,
      "text": "이번 선고 과정에서 서울 곳곳의 투표 현장에 큰 혼란이 있었습니다."
    },
    {
      "start": 103.6,
      "end": 111.77,
      "text": "민주주의의 가장 기본이자 신성한 권리인 시민들의 참정권이 심해받는 사퇴에 대해"
    },
    {
      "start": 111.77,
      "end": 115.68,
      "text": "후보자로서의 깊은 유감을 표합니다."
    },
    {
      "start": 115.68,
      "end": 123.38,
      "text": "시민들이 위대한 승리를 만들어주었다고 해서 그 과정에서 발생한 이 중대한 결함까지"
    },
    {
      "start": 123.38,
      "end": 127.62,
      "text": "아무 일 없었던 것처럼 묻어들 수는 없습니다."
    },
    {
      "start": 127.62,
      "end": 133.22,
      "text": "무엇이 문제였는지 철저히 규명하고 그에 상응하는 엄중한 책임과"
    },
    {
      "start": 133.22,
      "end": 137.78,
      "text": "근본적인 개선책이 반드시 뒤따라야 할 것입니다."
    },
    {
      "start": 137.78,
      "end": 140.74,
      "text": "현장의 혼란 속에서도 인내하며"
    },
    {
      "start": 140.74,
      "end": 143.18,
      "text": "민주주의를 지켜주신 시민 여러분의"
    },
    {
      "start": 143.18,
      "end": 147.73,
      "text": "가안잘한 마음은 결코 헛데이 하지 않겠습니다."
    },
    {
      "start": 147.73,
      "end": 151.29,
      "text": "시민 여러분, 저를 다시 선택하신 것은"
    },
    {
      "start": 151.29,
      "end": 153.73,
      "text": "저 개인에 대한 경렬하기보다"
    },
    {
      "start": 153.73,
      "end": 156.01,
      "text": "서울을 바꾸고 있는 정책과"
    },
    {
      "start": 156.01,
      "end": 159.67,
      "text": "방향에 대한 평가라고 생각합니다."
    },
    {
      "start": 159.67,
      "end": 163.43,
      "text": "지난 임기 동안 저와 서울시 공직자들은"
    },
    {
      "start": 163.43,
      "end": 166.95,
      "text": "끊겼던 주택공급의 물주기를 다시 튀었고"
    },
    {
      "start": 166.95,
      "end": 170.07,
      "text": "한강의 생태와 매력을 되살렸으며"
    },
    {
      "start": 170.07,
      "end": 174.6,
      "text": "흐색빛도심 곳곳에 푸른 녹질을 채웠습니다."
    },
    {
      "start": 174.6,
      "end": 178.68,
      "text": "강남북이 함께 성장하는 균형발전의 기트를 마련했고"
    },
    {
      "start": 178.68,
      "end": 181.2,
      "text": "약자와의 동행을 시점을 이 중심에"
    },
    {
      "start": 181.2,
      "end": 183.78,
      "text": "판단하게 세웠습니다."
    },
    {
      "start": 183.78,
      "end": 187.62,
      "text": "시민 여러분께서는 어렵게 시작된 이 변화가"
    },
    {
      "start": 187.62,
      "end": 191.79,
      "text": "앞으로도 중단없이 계속되기를 바라셨습니다."
    },
    {
      "start": 191.79,
      "end": 199.52,
      "text": "지난 5년 동안 보답 더 큰 변화와 더 좋은 결과로 반드시 보답드리도록 하겠습니다."
    },
    {
      "start": 199.52,
      "end": 205.52,
      "text": "아울러, 저를 지지하지 않으신 분들의 목소리도 더 노력하라는 채찍질로 알려요."
    },
    {
      "start": 205.52,
      "end": 208.58,
      "text": "결론, 다시 일하 시간입니다."
    },
    {
      "start": 208.58,
      "end": 214.76,
      "text": "당장 시즌의 삶을 지루는 문제부터 하나하나 해결해나가도록 하겠습니다."
    },
    {
      "start": 214.76,
      "end": 222.11,
      "text": "지속는 월세는 서민들을 위한 주거사다리 보건대책을 즉시 점동하겠습니다."
    },
    {
      "start": 222.11,
      "end": 234.04,
      "text": "내수 침체와 보물가 속에서 벼랑 끝에 몰리는 소상공인과 자유욕자분들이 다시 이어서 실수 있도록 실질적인 상권 활성화 대책을 가동하겠습니다."
    },
    {
      "start": 234.04,
      "end": 242.43,
      "text": "그 무엇보다 선공이 안중 발생한 소소문 고가차도 붕괴 사고로 시민 여러분의 불안이 크실 줄 압니다."
    },
    {
      "start": 242.43,
      "end": 246.75,
      "text": "업무에 복귀하는 측식 서울 시내 모든 노부 인프라와"
    },
    {
      "start": 246.75,
      "end": 253.63,
      "text": "공사장을 대상으로 고강도 특별 안전 점검에 착수하도록 하겠습니다."
    },
    {
      "start": 253.63,
      "end": 258.81,
      "text": "곧 다가올 기습적인 폭우와 폭염에도 단 한 명의 취약계층도 소외되거나"
    },
    {
      "start": 258.81,
      "end": 264.5,
      "text": "다치는 일이 없더라 한 치의 빈틈 없이 대비하도록 하겠습니다."
    },
    {
      "start": 264.5,
      "end": 269.72,
      "text": "시민 여러분께서 허락해 주신 마지막 4년 제 모든 경험과 영향을"
    },
    {
      "start": 269.72,
      "end": 281.75,
      "text": "서울을 위해 쏟아붙겠습니다. 그리고 정원호 후보님을 비롯하여 함께 경쟁했던 모든 후보님들 참으로 수고 많이 하셨습니다."
    },
    {
      "start": 281.75,
      "end": 312.29,
      "text": "시민 여러분 다시 한 번 감사드립니다. 어디에 사시든 노력한 만큼 공정한 기회를 얻을 수 있고 그리고 더 따뜻하고 더 건강한."
    },
    {
      "start": 312.29,
      "end": 315.11,
      "text": "지난 선거기간 동안 굉장히 더운 여름에도"
    },
    {
      "start": 315.11,
      "end": 318.63,
      "text": "늘 후보님과 함께했던 언론이 여러분들이 다 와있습니다."
    },
    {
      "start": 318.63,
      "end": 320.93,
      "text": "밤사이 잠 못 주무시고"
    },
    {
      "start": 320.93,
      "end": 323.89,
      "text": "다들 같은 마음으로 지켜보셨을 것 같았을 것 같았는데"
    },
    {
      "start": 323.89,
      "end": 327.11,
      "text": "마지막 질의응답 과정들을 좀 가졌으면 합니다."
    },
    {
      "start": 327.11,
      "end": 329.81,
      "text": "질문 있으신 기자님, 질문?"
    },
    {
      "start": 329.81,
      "end": 335.0,
      "text": "방금 전에 말씀드린 것처럼 선거전이 시작될때부터"
    },
    {
      "start": 335.0,
      "end": 338.2,
      "text": "오늘의 선거전까지 한 순간나"
    },
    {
      "start": 338.2,
      "end": 340.96,
      "text": "승지를 확신하지 않는 적은 없습니다."
    },
    {
      "start": 340.96,
      "end": 352.4,
      "text": "그러나 마음가진만큼은 늘 몇 퍼센트 지고 있는 후보다 도전자의 정신으로 처음부터까지 성공을 입출했다는 마음가진로 이랬습니다."
    },
    {
      "start": 352.4,
      "end": 360.61,
      "text": "정말 이렇게 다시 한 번 신뢰를 보내주신 서울신미성분들께 깊이 감사드리고요."
    },
    {
      "start": 360.61,
      "end": 368.01,
      "text": "정말 뼈가 주어지도록 열심히 일해서 그 성과로 서울신미성분들께 보답드리도록 하겠습니다."
    },
    {
      "start": 368.01,
      "end": 370.01,
      "text": "정말 최선의 노력을 다하겠습니다."
    },
    {
      "start": 370.01,
      "end": 372.17,
      "text": "감사합니다."
    },
    {
      "start": 372.17,
      "end": 375.17,
      "text": "다음 질문 있으시겠습니까?"
    },
    {
      "start": 375.17,
      "end": 377.17,
      "text": "말씀이시죠?"
    },
    {
      "start": 377.17,
      "end": 383.97,
      "text": "출구도사 때 어떤 신경을 저는 내일도 그리고 역전화 사실 때는 어떤 신경이었을까요?"
    },
    {
      "start": 383.97,
      "end": 388.97,
      "text": "네, 사실 출구도사가 나왔을 때는 좀 당황하기는 했습니다."
    },
    {
      "start": 390.97,
      "end": 395.97,
      "text": "생각했던 것보다 격차가 많이 벌어진 걸 보면서"
    },
    {
      "start": 395.97,
      "end": 402.97,
      "text": "다소 제가 현장에서 느꼈던 민신과 많이 괴리된 출구 조사, 예측 조사치를 보면서"
    },
    {
      "start": 402.97,
      "end": 409.97,
      "text": "속으로는 그럴 리가 없는데 시키면서도 또 객관적인 수치가 막 엄중하기 때문에"
    },
    {
      "start": 409.97,
      "end": 414.97,
      "text": "조금 더 마음이 힘들어진 순간도 있었습니다."
    },
    {
      "start": 414.97,
      "end": 421.22,
      "text": "그러나 개표가 거듭되면서 조금씩 조금씩 격차가 줄어드는 모습을 보면서"
    },
    {
      "start": 421.22,
      "end": 427.49,
      "text": "그래서 새벽 한 다섯 시경에는 승리를 확신할 수 있었습니다."
    },
    {
      "start": 427.49,
      "end": 429.15,
      "text": "정말 다시 한 번 감사드립니다."
    },
    {
      "start": 429.15,
      "end": 435.76,
      "text": "고맙습니다."
    },
    {
      "start": 435.76,
      "end": 439.36,
      "text": "저는 약속한 것은 꼭 지킵니다."
    },
    {
      "start": 439.36,
      "end": 445.92,
      "text": "지금 서울의 최대 현안이 원일 원일해도 부동산 문제입니다."
    },
    {
      "start": 445.92,
      "end": 452.92,
      "text": "정말 많은 서민들이 전세 물량이 급감하고 있고 월세가 폭등하는"
    },
    {
      "start": 452.92,
      "end": 457.54,
      "text": "와중에 극심한 고통을 느끼고 계십니다."
    },
    {
      "start": 457.54,
      "end": 460.9,
      "text": "그것은 분명히 지난 선거 이간 동안에"
    },
    {
      "start": 460.9,
      "end": 465.14,
      "text": "다문이 선거를 의식한 부동산 정책들을 펼친"
    },
    {
      "start": 465.14,
      "end": 467.67,
      "text": "부작용이라고 저는 확신합니다."
    },
    {
      "start": 467.67,
      "end": 472.57,
      "text": "그런 의미에서 아마 정부도 선거가 끝났으니만큼"
    },
    {
      "start": 472.57,
      "end": 478.13,
      "text": "스스로 방향 전환을 고려하고 모색해야 될 시점이라고 저는 생각을 하고요."
    },
    {
      "start": 478.13,
      "end": 482.06,
      "text": "제가 유차 강조해서 말씀드리는 것처럼"
    },
    {
      "start": 482.06,
      "end": 486.74,
      "text": "새로운 의미가 시작되는 첫 주 공무원에 참석을 해서"
    },
    {
      "start": 486.74,
      "end": 490.9,
      "text": "진심을 담아서 대통령원과 관계 부서,"
    },
    {
      "start": 490.9,
      "end": 494.94,
      "text": "장관인들께 민심을 전달하겠습니다."
    },
    {
      "start": 494.94,
      "end": 499.03,
      "text": "저는 진심은 늘 통한다고 생각합니다."
    },
    {
      "start": 499.03,
      "end": 501.43,
      "text": "그마도 방향 전환을 하지 않으면"
    },
    {
      "start": 501.43,
      "end": 503.43,
      "text": "앞으로 1년 뒤 2년 뒤가"
    },
    {
      "start": 503.43,
      "end": 507.52,
      "text": "더 참혹한 부동산 참사로 이어질 것입니다."
    },
    {
      "start": 507.52,
      "end": 510.37,
      "text": "확실하고 저는 그렇게 확신하고 있기 때문에"
    },
    {
      "start": 510.37,
      "end": 512.83,
      "text": "그러한 저의 확신으로 잘 전달되면"
    },
    {
      "start": 512.83,
      "end": 517.14,
      "text": "방향 전환이 이어질 거라고 기대하고 있습니다."
    },
    {
      "start": 517.14,
      "end": 519.09,
      "text": "그렇게 하겠습니다."
    },
    {
      "start": 519.09,
      "end": 522.12,
      "text": "TVS입니다."
    },
    {
      "start": 522.12,
      "end": 524.28,
      "text": "안녕하세요. TVS 박상현입니다."
    },
    {
      "start": 524.28,
      "end": 528.28,
      "text": "TVS의 관계는 해야될 수 없는 관계입니다."
    },
    {
      "start": 528.28,
      "end": 532.28,
      "text": "TVS에 관해서는 전원으로서 존중을 했습니다."
    },
    {
      "start": 532.28,
      "end": 536.28,
      "text": "충분한 기회도 드렸던 걸로 기억을 합니다."
    },
    {
      "start": 536.28,
      "end": 540.28,
      "text": "TVS 구성원 여러분들 다 기억하고 계시겠지만"
    },
    {
      "start": 540.28,
      "end": 544.28,
      "text": "끝까지 시위에는 아주 강력한 입장이었지만"
    },
    {
      "start": 544.28,
      "end": 550.26,
      "text": "저는 이제 여지를 두겨고 노력하는 모습을 지켜보셨을 겁니다."
    },
    {
      "start": 550.26,
      "end": 553.51,
      "text": "지금도 마음은 같습니다."
    },
    {
      "start": 553.51,
      "end": 560.55,
      "text": "공영방송이기 때문에 공정성이 지켜져야 됩니다."
    },
    {
      "start": 560.55,
      "end": 567.55,
      "text": "그런데 당시에 여러 가지 어려움을 겪던 TVS는"
    },
    {
      "start": 567.55,
      "end": 571.92,
      "text": "공정성을 상실했다는 것은 인정을 해야 될 겁니다."
    },
    {
      "start": 571.92,
      "end": 575.71,
      "text": "보영방송이 꽤 오래되거든요."
    },
    {
      "start": 575.71,
      "end": 584.27,
      "text": "전혀 이런 점을 충분히 가면 안 되기가"
    },
    {
      "start": 584.27,
      "end": 585.83,
      "text": "보여지길 바랍니다."
    },
    {
      "start": 585.83,
      "end": 590.72,
      "text": "그것을 바탕으로 해서 새로운 방향전환이"
    },
    {
      "start": 590.72,
      "end": 593.24,
      "text": "검토가 되었으면 저도 좋겠습니다."
    },
    {
      "start": 593.24,
      "end": 595.12,
      "text": "저 혼자 결정하는 문제가 아니라"
    },
    {
      "start": 595.12,
      "end": 598.88,
      "text": "시의회와 의원에서 결정해야 하는 만큼"
    },
    {
      "start": 598.88,
      "end": 603.44,
      "text": "새로운 분위기, 새로운 분위기를 시작할"
    },
    {
      "start": 603.44,
      "end": 606.86,
      "text": "가능성으로 전혀 닿지는 않겠습니다."
    },
    {
      "start": 606.86,
      "end": 611.3,
      "text": "네, 이 정도면 질의응답이 됐을까 싶은데, 마지막으로 주시겠습니까?"
    },
    {
      "start": 619.3,
      "end": 623.84,
      "text": "성건동의관 또한 이번 선거의 의미에 대해서"
    },
    {
      "start": 623.84,
      "end": 630.88,
      "text": "시작된 변화를 압도적으로 만지게 달라는 시민 여러분의 뜻으로 받아들입니다"
    },
    {
      "start": 630.88,
      "end": 636.02,
      "text": "또 한 가지 정치기는 의미를 부여하자면"
    },
    {
      "start": 636.02,
      "end": 644.97,
      "text": "이번 선거전에 돌입한 초위에 공소치서 특검을 대통령께서 직접 시동을 보셨죠."
    },
    {
      "start": 644.97,
      "end": 651.09,
      "text": "민주당도 여기에 화답을 하면서 그 처리를 연기해놓은 것이지"
    },
    {
      "start": 651.09,
      "end": 654.82,
      "text": "포기한다는 선언은 없었습니다."
    },
    {
      "start": 654.82,
      "end": 658.22,
      "text": "거기에 대한 서울 시민들의 평가와"
    },
    {
      "start": 658.22,
      "end": 665.78,
      "text": "이번 서울시의 선거 결과에 당겨있다고 저는 분명히 경고의 말씀을 대통령께 드립니다."
    },
    {
      "start": 665.78,
      "end": 669.03,
      "text": "이부분만큼은 자제해 주시기 바랍니다."
    },
    {
      "start": 669.03,
      "end": 671.54,
      "text": "혹시 민주당이 통과시키더라고요."
    },
    {
      "start": 671.54,
      "end": 675.09,
      "text": "대통령께서 거부권을 행사하시는 것이"
    },
    {
      "start": 675.09,
      "end": 678.25,
      "text": "국민의힘에 대한 돌이라고 생각을 하고요."
    },
    {
      "start": 678.25,
      "end": 682.33,
      "text": "이번 선거가 바로 그러한 의미를 담은 선거 결과다"
    },
    {
      "start": 682.33,
      "end": 684.61,
      "text": "이런 것을 다시 한 번"
    },
    {
      "start": 684.61,
      "end": 697.37,
      "text": "강력하게 말씀드리고 싶습니다."
    },
    {
      "start": 697.37,
      "end": 702.58,
      "text": "야권의 차기 리더 중에 가장 선거가 있나요?"
    },
    {
      "start": 702.58,
      "end": 707.88,
      "text": "서울시장은 직접적으로 정치에 투입하고는"
    },
    {
      "start": 707.88,
      "end": 711.12,
      "text": "당무엔에 개입하기가 한계다의 의미,"
    },
    {
      "start": 711.12,
      "end": 715.19,
      "text": "생활행정의 책임장으로 그런 의미에서"
    },
    {
      "start": 715.19,
      "end": 719.81,
      "text": "세계관에서 어떤 의미를 구경하든 저는 서울시장으로서"
    },
    {
      "start": 719.81,
      "end": 723.41,
      "text": "최선을 다해서 직무에 출실할 것입니다."
    },
    {
      "start": 723.41,
      "end": 727.8,
      "text": "그것이 아마 그동안에 다소 침체력이 다가오고"
    },
    {
      "start": 727.8,
      "end": 731.5,
      "text": "고수진영의 결과적으로 희망이 될 수 있고"
    },
    {
      "start": 731.5,
      "end": 737.48,
      "text": "그리고 본인이 정안에 바탕을 이룰 수 있는 그런 측면은 분명히 있겠습니다."
    },
    {
      "start": 737.48,
      "end": 742.68,
      "text": "여러 차례 강조해서 말씀드린 것처럼 서울시장직을 지켜내는 것이 바로"
    },
    {
      "start": 742.68,
      "end": 751.89,
      "text": "그런 모습 회생의 플랫폼이 되지 않겠는가 하는 의미를 지금까지 해왔고요."
    },
    {
      "start": 751.89,
      "end": 755.46,
      "text": "지금도 그 생각에는 변함이 없어요."
    },
    {
      "start": 755.46,
      "end": 761.85,
      "text": "그 정도로 아마 이번 서울을 지켜내는 의미가 평가되지 않을까"
    },
    {
      "start": 761.85,
      "end": 765.06,
      "text": "전아린대로는 그렇게 생각하고 있습니다."
    },
    {
      "start": 765.06,
      "end": 768.36,
      "text": "정말 마지막 질문이 하나 있다고 했어요?"
    },
    {
      "start": 768.36,
      "end": 772.22,
      "text": "이런 것처럼 이번 투표지 구족 사태는"
    },
    {
      "start": 772.22,
      "end": 775.72,
      "text": "참으로 통탄할 일입니다."
    },
    {
      "start": 775.72,
      "end": 779.74,
      "text": "감이 평가하자면 선관의 조직은요."
    },
    {
      "start": 779.74,
      "end": 783.66,
      "text": "정말 이번에 크게 반성해야 됩니다."
    },
    {
      "start": 783.66,
      "end": 786.26,
      "text": "제가 경험한 공조직 중에"
    },
    {
      "start": 786.26,
      "end": 791.23,
      "text": "가장 긴장감이 떨어지는 조직이 선관의 조직입니다."
    },
    {
      "start": 791.23,
      "end": 794.51,
      "text": "어떻게 민주주의 국가에서"
    },
    {
      "start": 794.51,
      "end": 798.17,
      "text": "투표 용지를 충분히 준비하지 못해서"
    },
    {
      "start": 798.17,
      "end": 801.76,
      "text": "이런 큰 권선이 빚어질 수 있겠습니다."
    },
    {
      "start": 801.76,
      "end": 806.57,
      "text": "정말 선관위를 해체하고 새로 만든다는"
    },
    {
      "start": 806.57,
      "end": 809.97,
      "text": "그런 각보에 심정하고 근본부터"
    },
    {
      "start": 809.97,
      "end": 816.3,
      "text": "완전히 혁신을 하겠다 하는 그런 각오로"
    },
    {
      "start": 816.3,
      "end": 817.93,
      "text": "인해야 되겠고요."
    },
    {
      "start": 817.93,
      "end": 821.45,
      "text": "그런 의미에서 행안부도 책임을"
    },
    {
      "start": 821.45,
      "end": 823.36,
      "text": "연할 수 없습니다."
    },
    {
      "start": 823.36,
      "end": 825.7,
      "text": "대통령도 이문에 대해서 책임을"
    },
    {
      "start": 825.7,
      "end": 832.7,
      "text": "지금 마치 선관위가 모든 것을 책임져야 할 것처럼 모양이 되어 있는데요."
    },
    {
      "start": 832.7,
      "end": 835.7,
      "text": "결과적으로는 모두 베트몬 책임입니다."
    },
    {
      "start": 835.7,
      "end": 839.15,
      "text": "근본적인 개혁을 촉구하고요."
    },
    {
      "start": 839.15,
      "end": 845.47,
      "text": "이번 기회에 선관위에 대해서 모든 불신이 말끔히 씻겨서 나갈 수 있는"
    },
    {
      "start": 845.47,
      "end": 847.47,
      "text": "본질적인 개혁을 촉구하는 바입니다."
    }
  ]
}