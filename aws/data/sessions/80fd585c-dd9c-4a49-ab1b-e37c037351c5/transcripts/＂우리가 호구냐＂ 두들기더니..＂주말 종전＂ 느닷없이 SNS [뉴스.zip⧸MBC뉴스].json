{
  "video_path": "/app/data/sessions/80fd585c-dd9c-4a49-ab1b-e37c037351c5/downloads/＂우리가 호구냐＂ 두들기더니..＂주말 종전＂ 느닷없이 SNS [뉴스.zip⧸MBC뉴스].mp4",
  "language": "ko",
  "duration": 256.6269375,
  "segments": [
    {
      "start": 0.37,
      "end": 4.99,
      "text": "미국 트럼프 대통령은 이곳 시간으로 11일 오후 들어 갑자기 이란에 대한"
    },
    {
      "start": 4.99,
      "end": 9.39,
      "text": "공습을 취소한다는 글을 SNS에 띄웠습니다."
    },
    {
      "start": 9.39,
      "end": 14.15,
      "text": "논의는 이란 최고 지도부까지 올라가 승인을 받았다고 취소 배경을"
    },
    {
      "start": 14.15,
      "end": 15.63,
      "text": "밝혔습니다."
    },
    {
      "start": 15.63,
      "end": 19.39,
      "text": "오전까지만 해도 사흘 연속 공습을 예고하며 석유"
    },
    {
      "start": 19.39,
      "end": 23.07,
      "text": "인프라도 점령할 거라고 위협했는데 도련 태도를"
    },
    {
      "start": 23.07,
      "end": 24.55,
      "text": "바꾼 겁니다."
    },
    {
      "start": 24.55,
      "end": 27.47,
      "text": "그러면서 긴급 브리핑을 열어 논의 내용과"
    },
    {
      "start": 27.47,
      "end": 31.11,
      "text": "증점은 세부 사항까지 포함해 미국과 이스라엘,"
    },
    {
      "start": 31.11,
      "end": 34.79,
      "text": "사우디아라비아, 아랍 에미리트 등 관련국 모두의"
    },
    {
      "start": 34.79,
      "end": 45.88,
      "text": "승인을 받았다고 강조했습니다."
    },
    {
      "start": 45.88,
      "end": 48.8,
      "text": "또 서명식은 주말에 유럽에서 J.D."
    },
    {
      "start": 48.8,
      "end": 51.48,
      "text": "벤스 부통령이 참석한 가운데 열릴 거라고"
    },
    {
      "start": 51.48,
      "end": 52.96,
      "text": "밝혔습니다."
    },
    {
      "start": 52.96,
      "end": 55.96,
      "text": "동시에 해상 봉쇄는 협상이 최종 타결될"
    },
    {
      "start": 55.96,
      "end": 59.56,
      "text": "까지 전면적으로 유지될 거라고 했습니다."
    },
    {
      "start": 59.56,
      "end": 62.92,
      "text": "태도가 수시로 바뀌는 특성을 감안하면 이번에도"
    },
    {
      "start": 62.92,
      "end": 66.4,
      "text": "결과를 끝까지 지켜봐야 하는 상황이지만 이틀"
    },
    {
      "start": 66.4,
      "end": 70.0,
      "text": "연속으로 양측간 전개되는 전투는 숨 고르기에"
    },
    {
      "start": 70.0,
      "end": 73.79,
      "text": "들어가며 최악의 위기를 넘긴 것으로 보입니다."
    },
    {
      "start": 73.79,
      "end": 78.03,
      "text": "하지만 트럼프 대통령의 SNS 언급 직후 이란 측은"
    },
    {
      "start": 78.03,
      "end": 81.35,
      "text": "아직 미국과 어떤 합의문도 승인된 바 없다고"
    },
    {
      "start": 81.35,
      "end": 83.91,
      "text": "조금 다른 입장을 드러냈습니다."
    },
    {
      "start": 83.91,
      "end": 87.19,
      "text": "이란 파르스 통신은 이란 협상팀의 정통한 소식"
    },
    {
      "start": 87.19,
      "end": 90.87,
      "text": "통을 인용해 양해각서와 관련해 어떤 문안도"
    },
    {
      "start": 90.87,
      "end": 93.43,
      "text": "승인된 바 없다고 전했습니다."
    },
    {
      "start": 93.43,
      "end": 96.99,
      "text": "다만 트럼프 대통령이 추가 요구 사항을 철회해"
    },
    {
      "start": 96.99,
      "end": 100.31,
      "text": "양해각서 초안으로 돌아간 만큼 이란도 합의의"
    },
    {
      "start": 100.31,
      "end": 103.79,
      "text": "응할 가능성이 크다고 전과 다른 유화적 태도를"
    },
    {
      "start": 103.79,
      "end": 105.32,
      "text": "보였습니다."
    },
    {
      "start": 105.32,
      "end": 108.28,
      "text": "미국 언론들은 양해각서 초안에는 휴전의"
    },
    {
      "start": 108.28,
      "end": 111.4,
      "text": "60일 연장과 호르모즈 해역의 전면 개방,"
    },
    {
      "start": 111.4,
      "end": 115.96,
      "text": "그리고 휴전 기간 동안 비핵화 합의 도출이라는 내용이 들어간 것으로"
    },
    {
      "start": 115.96,
      "end": 118.28,
      "text": "보인다고 보도하고 있습니다."
    },
    {
      "start": 118.28,
      "end": 122.2,
      "text": "비록 양측의 미묘한 신경전은 계속되고 있지만,"
    },
    {
      "start": 122.2,
      "end": 126.16,
      "text": "월드컵 개막일에 맞춰 공습 취소 소식이 나오면서"
    },
    {
      "start": 126.16,
      "end": 129.96,
      "text": "국제 유가는 2% 이상 크게 하락했습니다."
    },
    {
      "start": 129.96,
      "end": 135.71,
      "text": "워싱턴에서 MBC 뉴스 김재웅입니다."
    },
    {
      "start": 135.71,
      "end": 138.47,
      "text": "번쩍이는 성관과 함께 미사일이 발사되자"
    },
    {
      "start": 138.47,
      "end": 141.57,
      "text": "어둠속 미 해군 군함의 모습이 드러납니다."
    },
    {
      "start": 141.57,
      "end": 145.81,
      "text": "이란 시각으로 자정을 지난 무렵 미군의 공습이 다시 시작됐습니다."
    },
    {
      "start": 146.11,
      "end": 150.31,
      "text": "지난 8일 호르몬즈 해역에서 미군 아파체 일기가 격추된 뒤 이틀째"
    },
    {
      "start": 150.61,
      "end": 154.61,
      "text": "법업 공습을 이어간 겁니다. 미군 중부사령부는 이란 전역의 방공망과"
    },
    {
      "start": 154.89,
      "end": 158.35,
      "text": "군 감시 설비, 통신망을 타격했다고 밝혔습니다."
    },
    {
      "start": 158.63,
      "end": 163.23,
      "text": "기존 이란 남부 해안값뿐만 아니라 수도 태일안 인근의 카라지까지 공습 구역을"
    },
    {
      "start": 163.53,
      "end": 167.82,
      "text": "확대했습니다. 트럼프 대통령은 토마호크 49발을"
    },
    {
      "start": 168.12,
      "end": 171.32,
      "text": "태일안 인근과 이란 서부 해안 지역에 발사했다고 밝혔습니다."
    },
    {
      "start": 171.66,
      "end": 176.66,
      "text": "그러면서 이란 폭격은 곧 멈추겠지만 이란이 합의안에 서명하지 않으면 내일밤"
    },
    {
      "start": 176.96,
      "end": 178.56,
      "text": "폭격으로 박살낼 거라고 경고했습니다."
    },
    {
      "start": 184.9,
      "end": 188.4,
      "text": "미국의 공습마다 이란도 곧바로 보복 공격에 나섰습니다."
    },
    {
      "start": 188.7,
      "end": 193.7,
      "text": "이란 현명수비대는 바레인 등 중동지역 미군기지 18곳을 미사일과 드론으로"
    },
    {
      "start": 194.04,
      "end": 198.04,
      "text": "공격했으며 유르단 공군기지의 미군 전투기 여러 대를 파괴했다고"
    },
    {
      "start": 198.04,
      "end": 201.48,
      "text": "주장했습니다. 나가 트럼프의 아킬레스건인 호르모지"
    },
    {
      "start": 201.74,
      "end": 204.64,
      "text": "회읍을 다시 전면 폐쇄하고 해업통과를"
    },
    {
      "start": 204.94,
      "end": 207.94,
      "text": "시도하는 모든 선박에 발포할 거라고 선언했습니다."
    },
    {
      "start": 208.22,
      "end": 213.38,
      "text": "실제로 이랑부는 해업통과를 시도한 선박 두 척에 발포를 감행했다고 현지"
    },
    {
      "start": 213.66,
      "end": 214.82,
      "text": "매체는 전했습니다."
    },
    {
      "start": 222.55,
      "end": 226.79,
      "text": "다만 미 중부 사령부는 상선들이 호르모지 회읍을 계속 드나들고 있다며"
    },
    {
      "start": 226.79,
      "end": 232.29,
      "text": "이란 측 주장을 즉각 반박했습니다."
    },
    {
      "start": 232.33,
      "end": 235.79,
      "text": "미국 CNN 방송은 외교적 노력을 복잡하게 만들 상황이 발생했지만 여전히"
    },
    {
      "start": 235.83,
      "end": 240.29,
      "text": "협상은 진행 중이라면서 중재를 맡은 카타르 대표단이 미국과 조율한 내용을"
    },
    {
      "start": 240.33,
      "end": 243.29,
      "text": "가지고 태일안을 찾아 오늘 새벽까지 협상을 이어갔다고 보도했습니다."
    },
    {
      "start": 243.33,
      "end": 248.33,
      "text": "MBC 뉴스 나세웅입니다."
    }
  ]
}