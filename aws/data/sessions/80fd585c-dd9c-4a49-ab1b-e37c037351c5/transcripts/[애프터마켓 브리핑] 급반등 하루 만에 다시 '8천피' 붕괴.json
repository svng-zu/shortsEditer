{
  "video_path": "/app/data/sessions/80fd585c-dd9c-4a49-ab1b-e37c037351c5/downloads/[애프터마켓 브리핑] 급반등 하루 만에 다시 '8천피' 붕괴.mp4",
  "language": "ko",
  "duration": 182.60175,
  "segments": [
    {
      "start": 0.46,
      "end": 2.46,
      "text": "액터 마켓 브리핑입니다."
    },
    {
      "start": 2.46,
      "end": 6.46,
      "text": "급등락이 반복되면서 변동성 장세가 이어지고 있습니다."
    },
    {
      "start": 6.46,
      "end": 9.34,
      "text": "심지어 장중에 매크롱 환경 부담이 커지면서"
    },
    {
      "start": 9.34,
      "end": 11.86,
      "text": "양지수 모두 낙폭을 키우기도 했는데요."
    },
    {
      "start": 11.86,
      "end": 15.0,
      "text": "특히 아시아 증시에서 분리한 재료가 부각됐습니다."
    },
    {
      "start": 15.0,
      "end": 17.66,
      "text": "오늘 오전에 발표된 일본의 5월 PPI가"
    },
    {
      "start": 17.66,
      "end": 21.82,
      "text": "예상치 5.5%를 웃도는 6.3%를 기록했고"
    },
    {
      "start": 21.82,
      "end": 24.26,
      "text": "심지어 일본 36물 국채이철 수요도"
    },
    {
      "start": 24.26,
      "end": 27.1,
      "text": "부진하게 나오자 리케이지수도 코스피 지수도"
    },
    {
      "start": 27.1,
      "end": 28.58,
      "text": "낙폭을 키웠습니다."
    },
    {
      "start": 28.58,
      "end": 33.26,
      "text": "중국 CPI와 PPI 격차도 커지면서 경기 둔화 우려가 커지고 있죠."
    },
    {
      "start": 33.26,
      "end": 35.82,
      "text": "우선 애프터마켓 분위기부터 보겠습니다."
    },
    {
      "start": 35.82,
      "end": 37.78,
      "text": "배용주흘은 먼저 보겠습니다."
    },
    {
      "start": 37.78,
      "end": 41.1,
      "text": "정규장에서 급락했던 삼성전자와 SK하이닉스"
    },
    {
      "start": 41.1,
      "end": 43.74,
      "text": "그래도 현재는 낙폭을 회복하고 있습니다."
    },
    {
      "start": 43.74,
      "end": 47.14,
      "text": "간반미고 크루소의 데이터센터 개발 일시 중단으로"
    },
    {
      "start": 47.14,
      "end": 51.26,
      "text": "AI 인프라 공급이 예상보다 지연된 한 우려가 커졌는데요."
    },
    {
      "start": 51.26,
      "end": 55.94,
      "text": "다만 오늘 오후 2시 30분쯤 TSMC의 5월 매출이 발표됐고"
    },
    {
      "start": 55.94,
      "end": 60.72,
      "text": "전년대비 30% 급증하자 이 시점의 기점으로 두 종목 모두 하락폭을"
    },
    {
      "start": 60.72,
      "end": 62.08,
      "text": "만회하고 있습니다."
    },
    {
      "start": 62.08,
      "end": 64.76,
      "text": "이어서 상승률 높은 종목들 보겠습니다."
    },
    {
      "start": 64.76,
      "end": 68.42,
      "text": "오늘 태양광 관련자들이 전반적으로 강세해 보여주고 있습니다."
    },
    {
      "start": 68.42,
      "end": 73.1,
      "text": "특히 SK와 KK열이 1조 8천억 원 규모에 신재생 에너지 빅디를"
    },
    {
      "start": 73.1,
      "end": 77.24,
      "text": "체결했다는 소식에 어제 시간 외 거래서부터 SK이터닉스와 SK"
    },
    {
      "start": 77.24,
      "end": 79.36,
      "text": "오션플랜트가 상승하고 있습니다."
    },
    {
      "start": 79.36,
      "end": 82.36,
      "text": "현재도 SK이터닉스는 상한가 풀리지 않고 있고요."
    },
    {
      "start": 82.36,
      "end": 86.6,
      "text": "SK 오션플랜트는 19% 가깝게 올라가고 있습니다."
    },
    {
      "start": 86.6,
      "end": 89.32,
      "text": "이외에도 태양광 관련주에는 포재가 많은데요."
    },
    {
      "start": 89.32,
      "end": 91.72,
      "text": "스페이스엑스 상장을 앞조고 우주 태양광을 향한"
    },
    {
      "start": 91.72,
      "end": 94.8,
      "text": "관심이 이어지고 있고, 또 미국이 태양광 공급망"
    },
    {
      "start": 94.8,
      "end": 97.48,
      "text": "탈중국 기조를 보이고, 관련 내용이 담긴"
    },
    {
      "start": 97.48,
      "end": 100.0,
      "text": "무역 확장법은 이번 달에 발표가 예정되어"
    },
    {
      "start": 100.0,
      "end": 101.0,
      "text": "있습니다."
    },
    {
      "start": 101.0,
      "end": 103.36,
      "text": "미국에서도 중국 공급망을 거치지 않는"
    },
    {
      "start": 103.36,
      "end": 105.76,
      "text": "태양광주들이 신고가 행진을 이어가자"
    },
    {
      "start": 105.76,
      "end": 108.44,
      "text": "국내 관련주들도 영향을 받고 있습니다."
    },
    {
      "start": 108.44,
      "end": 110.88,
      "text": "정규장 마감 후에는 파미세리 급등하고"
    },
    {
      "start": 110.88,
      "end": 111.64,
      "text": "있습니다."
    },
    {
      "start": 111.64,
      "end": 120.52,
      "text": "엔비디아 AI 서버용 기판인 CCL의 핵심 원재료를 부선을 독점으로 공급한다는 보도가 정규장 마감 후 나오면서 급등하고 있습니다."
    },
    {
      "start": 120.52,
      "end": 126.12,
      "text": "AI 서버 수요 확대에 따라서 관련 소재 수요도 급증하기 때문에 수의 기대가 커지고 있고요."
    },
    {
      "start": 126.12,
      "end": 131.68,
      "text": "또 하반기 울산 3공장 가동 후엔 생산 능력도 2배 확대될 것으로 예상됩니다."
    },
    {
      "start": 131.68,
      "end": 134.28,
      "text": "이어서 하락률 높은 종목들 보겠습니다."
    },
    {
      "start": 134.28,
      "end": 137.2,
      "text": "현재 순위권에 로봇주들이 많이 위치해 있습니다."
    },
    {
      "start": 137.2,
      "end": 141.92,
      "text": "젠슨 황 시 이후 방한 일정이 마무리되면서 로봇스타 약세 보여주고 있고"
    },
    {
      "start": 141.92,
      "end": 143.92,
      "text": "3거리로 연속 하락세 걷습니다."
    },
    {
      "start": 143.92,
      "end": 146.24,
      "text": "레이버도 연을 약세 보여주고 있습니다."
    },
    {
      "start": 146.24,
      "end": 149.12,
      "text": "이어서 거리량 활발한 종목들 보겠습니다."
    },
    {
      "start": 149.12,
      "end": 151.52,
      "text": "현재 하나 솔루션이 거리량 활발하고"
    },
    {
      "start": 151.52,
      "end": 154.28,
      "text": "주가도 4% 넘게 극등하고 있습니다."
    },
    {
      "start": 154.28,
      "end": 156.2,
      "text": "미국에 짓는 태양광 생산기지인"
    },
    {
      "start": 156.2,
      "end": 158.24,
      "text": "솔라허브가 완공되기도 했고"
    },
    {
      "start": 158.24,
      "end": 161.72,
      "text": "또 7월부터 양산에 들어가는 소식이 전해졌는데요."
    },
    {
      "start": 161.72,
      "end": 163.8,
      "text": "정규장에서 점차 낙폭을 줄이다가"
    },
    {
      "start": 163.8,
      "end": 166.68,
      "text": "마감 직전에 다시 극등제를 이어갔습니다."
    },
    {
      "start": 166.68,
      "end": 172.18,
      "text": "이외에도 SK 오션플랜트와 SK 토닉스 거래량 활발하고 후성도 22% 넘게"
    },
    {
      "start": 172.18,
      "end": 173.86,
      "text": "급등하고 있습니다."
    },
    {
      "start": 173.86,
      "end": 176.62,
      "text": "이렇게 앱터 마켓 흐름과 특징조까지 봤습니다."
    },
    {
      "start": 176.62,
      "end": 179.78,
      "text": "이어서 오늘 밤 열리는 뉴욕 증시도 함께 대비해보시죠."
    },
    {
      "start": 179.78,
      "end": 181.78,
      "text": "지금까지 앱터 마켓 브리핑이었습니다."
    }
  ]
}