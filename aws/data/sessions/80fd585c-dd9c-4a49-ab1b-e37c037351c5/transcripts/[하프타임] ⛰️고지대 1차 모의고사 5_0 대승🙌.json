{
  "video_path": "/app/data/sessions/80fd585c-dd9c-4a49-ab1b-e37c037351c5/downloads/[하프타임] ⛰️고지대 1차 모의고사 5_0 대승🙌.mp4",
  "language": "ko",
  "duration": 0,
  "segments": [
    {
      "start": 0.0,
      "end": 4.16,
      "text": "이런 어소선한 상황 속에서도 우리 태극 전사들의 분위기는 최상입니다."
    },
    {
      "start": 4.16,
      "end": 7.4,
      "text": "트리니다드 토바고아의 평가전에서 압승을 거뒀는데요."
    },
    {
      "start": 7.4,
      "end": 9.4,
      "text": "A 매치 3경기만의 승이었어요."
    },
    {
      "start": 9.4,
      "end": 11.1,
      "text": "그렇습니다. 3경기만의 승이어됐죠."
    },
    {
      "start": 11.1,
      "end": 15.56,
      "text": "지난 3월 홍명보 유럽 원정 평가전 코트디부아르전과"
    },
    {
      "start": 15.56,
      "end": 18.24,
      "text": "오스트리아전 2연패를 당했고 무득점이었습니다."
    },
    {
      "start": 18.24,
      "end": 20.92,
      "text": "그래서 경기적도 개선이 필요했고"
    },
    {
      "start": 20.92,
      "end": 23.76,
      "text": "또 득점 파괴력을 좀 올려줘야 되는 그런 상황에서"
    },
    {
      "start": 23.76,
      "end": 25.84,
      "text": "현재 솔트랙에서 고지대 훈련 중인데"
    },
    {
      "start": 25.84,
      "end": 29.28,
      "text": "역시 이번 평가전은 고지대 적응 여부"
    },
    {
      "start": 29.28,
      "end": 31.84,
      "text": "그리고 또 득점 파괴력을 올릴 수 있는지에"
    },
    {
      "start": 31.84,
      "end": 33.48,
      "text": "또 공격력에 대한 확인 여부"
    },
    {
      "start": 33.48,
      "end": 37.1,
      "text": "그리고 전체적인 또 백 3를 기준으로 한"
    },
    {
      "start": 37.1,
      "end": 39.56,
      "text": "경직된 전수론회에서 탈패할 수 있는지의 여부"
    },
    {
      "start": 39.56,
      "end": 42.44,
      "text": "여러 가지를 확인할 수 있는 그런 경기였습니다."
    },
    {
      "start": 42.44,
      "end": 47.28,
      "text": "일단 상대팀이 고지대로 원정을 할 수 있는 팀이 한계가 있었기 때문에"
    },
    {
      "start": 47.28,
      "end": 48.76,
      "text": "좀 약체가 왔습니다."
    },
    {
      "start": 48.76,
      "end": 52.08,
      "text": "피파랭킹 102위인 트리니다드 토바고아가"
    },
    {
      "start": 52.08,
      "end": 54.56,
      "text": "이번 평가전 상대팀이었습니다."
    },
    {
      "start": 54.56,
      "end": 57.08,
      "text": "전체적으로 또 주축 선수 한 6명이 빠졌던"
    },
    {
      "start": 57.08,
      "end": 59.12,
      "text": "트리니다드 토발로 상대로 우리 대표팀이 완전히"
    },
    {
      "start": 59.12,
      "end": 60.84,
      "text": "경기를 주도하는 흐름이었고요."
    },
    {
      "start": 60.84,
      "end": 62.44,
      "text": "첫 번째 골 장면입니다."
    },
    {
      "start": 62.44,
      "end": 65.44,
      "text": "김진규의 로빙패스 김문환의 오른쪽에서의"
    },
    {
      "start": 65.44,
      "end": 66.8,
      "text": "섀도가 좋았고요."
    },
    {
      "start": 66.8,
      "end": 69.08,
      "text": "여기서 완벽한 어시스트를 송윤선수가 골"
    },
    {
      "start": 69.08,
      "end": 70.32,
      "text": "로 넣었습니다."
    },
    {
      "start": 70.32,
      "end": 73.04,
      "text": "송윤선수가 리그에서는 어시스트를 많이 하지만"
    },
    {
      "start": 73.04,
      "end": 75.88,
      "text": "득점을 하지 못했기 때문에 약간 그 부분"
    },
    {
      "start": 75.88,
      "end": 77.88,
      "text": "걱정하시는 팬들이 많았는데 오랜만에 득점"
    },
    {
      "start": 77.88,
      "end": 79.0,
      "text": "신고했고요."
    },
    {
      "start": 79.0,
      "end": 81.76,
      "text": "그리고 파널티킥 찬스가 또 왔어요."
    },
    {
      "start": 81.76,
      "end": 86.52,
      "text": "키커로 송윤선수가 자신감 있게 왼쪽으로"
    },
    {
      "start": 86.52,
      "end": 89.64,
      "text": "차 나오면서 멀티코를 신고했습니다."
    },
    {
      "start": 89.64,
      "end": 92.6,
      "text": "경기는 압도적으로 우리 대한민국이 앞선을"
    },
    {
      "start": 92.6,
      "end": 95.4,
      "text": "흐르면서 후반에는 교체 투입 때 황인범 선수의"
    },
    {
      "start": 95.4,
      "end": 100.04,
      "text": "원터치 패스에서 이동경 선수의 아주 기가 막힌"
    },
    {
      "start": 100.04,
      "end": 101.6,
      "text": "왼발 아웃프런트."
    },
    {
      "start": 101.6,
      "end": 103.56,
      "text": "빠른 타이밍에서 이 크로스였죠."
    },
    {
      "start": 103.56,
      "end": 106.8,
      "text": "그것을 조규성 선수가 멋지게 헤딩"
    },
    {
      "start": 106.8,
      "end": 107.56,
      "text": "골을 신고했습니다."
    },
    {
      "start": 107.56,
      "end": 110.64,
      "text": "조규성 선수도 상당히 오랜만에 득점이었고요."
    },
    {
      "start": 110.64,
      "end": 113.92,
      "text": "그리고 상대 빌더벨 미스에서 파널티킥"
    },
    {
      "start": 113.92,
      "end": 116.48,
      "text": "만들어낸 우리 대표팀이 황이샤 선수의"
    },
    {
      "start": 116.48,
      "end": 120.88,
      "text": "추가 골을 사하 대형으로 크게 앞선면서"
    },
    {
      "start": 120.88,
      "end": 124.24,
      "text": "본격력에서 못처럼 좀 시원한 모습을 보였고요."
    },
    {
      "start": 124.24,
      "end": 128.44,
      "text": "이후에는 크로스 찬스 세컨블이 이어졌는데"
    },
    {
      "start": 128.44,
      "end": 131.16,
      "text": "서령우 선수가 친척하게 아시스트를 해줬고"
    },
    {
      "start": 131.16,
      "end": 133.28,
      "text": "조규성 선수가 골을 넣었습니다."
    },
    {
      "start": 133.28,
      "end": 137.04,
      "text": "조규성 선수의 멀티골 트리다 토바골을"
    },
    {
      "start": 137.04,
      "end": 138.8,
      "text": "5호 대형으로 대팔렸고요."
    },
    {
      "start": 138.8,
      "end": 142.52,
      "text": "전술적으로도 이 날 또 이기혁 선수가 또"
    },
    {
      "start": 142.52,
      "end": 145.92,
      "text": "대표팀으로는 아주 오랜만에 다시 승선해서"
    },
    {
      "start": 145.92,
      "end": 149.32,
      "text": "백스리의 왼쪽 스톱으로서 변형적인 움직임을"
    },
    {
      "start": 149.32,
      "end": 152.12,
      "text": "가져가면서 상당히 좋은 활약을 이어갔던"
    },
    {
      "start": 152.12,
      "end": 153.24,
      "text": "그런 경기가 됐습니다."
    },
    {
      "start": 153.24,
      "end": 156.4,
      "text": "이야기를 해주신 것처럼 이번 월드컵의 화두,"
    },
    {
      "start": 156.4,
      "end": 158.84,
      "text": "고지대에서 치는 첫 경기였는데요."
    },
    {
      "start": 158.84,
      "end": 161.44,
      "text": "선수들이 움직임을 봤을 때 어떻게 적응을 잘"
    },
    {
      "start": 161.44,
      "end": 162.52,
      "text": "한 걸로 보였나요?"
    },
    {
      "start": 162.52,
      "end": 165.52,
      "text": "저는 이 경기에 제일 목적이 무엇이었을까"
    },
    {
      "start": 165.52,
      "end": 168.96,
      "text": "라고 생각을 해본다면 물론 전술 테스트 중요하죠."
    },
    {
      "start": 168.96,
      "end": 171.48,
      "text": "그리고 꼴찌목 깨는 거 중요합니다."
    },
    {
      "start": 171.48,
      "end": 174.2,
      "text": "그리고 수비 안정화 하는 거 물론 다 중요하지만"
    },
    {
      "start": 174.2,
      "end": 176.52,
      "text": "대표팀의 첫 번째는 저는 컨디션이"
    },
    {
      "start": 176.52,
      "end": 177.88,
      "text": "이었다고 봅니다."
    },
    {
      "start": 177.88,
      "end": 180.52,
      "text": "고지대에 적응해야 하는데 고지대에 적응을"
    },
    {
      "start": 180.52,
      "end": 182.96,
      "text": "하는 최고의 훈련법, 바로 실전을 치르는"
    },
    {
      "start": 182.96,
      "end": 183.92,
      "text": "거죠."
    },
    {
      "start": 183.92,
      "end": 188.16,
      "text": "그래서 출전 시간도 어떻게 보면 경기 흐름이나"
    },
    {
      "start": 188.16,
      "end": 192.68,
      "text": "선수분위기 이런 것들과 상관없이 선수한테"
    },
    {
      "start": 192.68,
      "end": 195.96,
      "text": "적합한 시간을 철저하게 나눠주는 방식으로"
    },
    {
      "start": 195.96,
      "end": 198.76,
      "text": "배분된 걸로 그렇게 알고 있습니다."
    },
    {
      "start": 198.76,
      "end": 201.44,
      "text": "이 경기를 통해서 결국 선수들이 얼마 만큼"
    },
    {
      "start": 201.44,
      "end": 205.64,
      "text": "고지대에서 몸 상태를 끌어올리는데 집중했다고"
    },
    {
      "start": 205.64,
      "end": 208.96,
      "text": "저는 보고 있고 전술적으로 훌륭했다 이런"
    },
    {
      "start": 208.96,
      "end": 211.12,
      "text": "평가를 하기에는 제가 보기에는 상대가 조금"
    },
    {
      "start": 211.12,
      "end": 213.8,
      "text": "약했던 거 아닌가 라는 생각을 합니다."
    },
    {
      "start": 213.8,
      "end": 215.12,
      "text": "정미언님은요."
    },
    {
      "start": 215.12,
      "end": 219.0,
      "text": "특히 이번 트위다 토바가우와의 첫 경기 같은 경우는"
    },
    {
      "start": 219.0,
      "end": 221.52,
      "text": "역시 일찍 와서 적응을 미리 하고 있었던"
    },
    {
      "start": 221.52,
      "end": 223.76,
      "text": "선수들 위주로 베스트를 또 짰어요."
    },
    {
      "start": 223.76,
      "end": 226.48,
      "text": "뒤늦게 합류한 김민제나 이런 유로파들은"
    },
    {
      "start": 226.48,
      "end": 229.36,
      "text": "선발에서 일단 제외를 하고 일정 시간 후반의"
    },
    {
      "start": 229.36,
      "end": 232.68,
      "text": "시간을 주는 그런 흐름에서 경기 운영을"
    },
    {
      "start": 232.68,
      "end": 235.12,
      "text": "했는데 이제 과거에 저희 방송에서도 우리"
    },
    {
      "start": 235.12,
      "end": 240.36,
      "text": "이정창 기자님이 고지대 같은 경우 논문 상으로는"
    },
    {
      "start": 240.36,
      "end": 244.68,
      "text": "2천 미터 이하는 사실 받는 영향 이 미미하다"
    },
    {
      "start": 244.68,
      "end": 247.0,
      "text": "이런 얘기도 했지만 이제 그거는 일반인의"
    },
    {
      "start": 247.0,
      "end": 252.36,
      "text": "관점이고 고강도 활동을 해야 되는 운동선수들"
    },
    {
      "start": 252.36,
      "end": 256.92,
      "text": "같은 경우는 1500미터 안팎에서도 상당한"
    },
    {
      "start": 256.92,
      "end": 257.92,
      "text": "영향을 받는다."
    },
    {
      "start": 257.92,
      "end": 260.48,
      "text": "물론 선수들마다의 차이는 있어요."
    },
    {
      "start": 260.48,
      "end": 263.68,
      "text": "어떤 선수들은 조금 미미하게 받는 선수도 있고"
    },
    {
      "start": 263.68,
      "end": 265.84,
      "text": "또 어떤 선수들은 삼각보다는 좀 심하게"
    },
    {
      "start": 265.84,
      "end": 268.4,
      "text": "영향을 받는 선수들도 있는데 어쨌든 대표팀"
    },
    {
      "start": 268.4,
      "end": 271.6,
      "text": "입장에서는 일관성 있는 어떤 팀 경기력을"
    },
    {
      "start": 271.6,
      "end": 274.0,
      "text": "유지하기 위해서 미리 가서 적응하는 것이"
    },
    {
      "start": 274.0,
      "end": 275.0,
      "text": "중요했고요."
    },
    {
      "start": 275.0,
      "end": 276.92,
      "text": "전적으로 효과가 있다고 보는데."
    },
    {
      "start": 276.92,
      "end": 281.6,
      "text": "트위다 토바가우가 아무리 약체팀이라도 후반에는"
    },
    {
      "start": 281.6,
      "end": 283.76,
      "text": "사실은 거의 움직이지 못했어요."
    },
    {
      "start": 283.76,
      "end": 285.88,
      "text": "그런데 이 선수들이 3일 전에 왔거든요."
    },
    {
      "start": 285.88,
      "end": 286.88,
      "text": "이 선수들은."
    },
    {
      "start": 286.88,
      "end": 287.88,
      "text": "상당히 힘들어하더군요."
    },
    {
      "start": 287.88,
      "end": 290.64,
      "text": "이런 부분에서 역시 우리가 1차전 체코."
    },
    {
      "start": 290.64,
      "end": 293.68,
      "text": "체코가 사실은 뒤늦게 플레오플 통해서 본선"
    },
    {
      "start": 293.68,
      "end": 296.8,
      "text": "인천이 확정이 되었기 때문에 미리 베이스 캠프나"
    },
    {
      "start": 296.8,
      "end": 298.4,
      "text": "또 이런 고시대 적응을 하기 위한 준비가 잘"
    },
    {
      "start": 298.4,
      "end": 299.6,
      "text": "안 돼 있습니다."
    },
    {
      "start": 299.6,
      "end": 303.34,
      "text": "그래서 체코는 거의 경기를 앞두고 한 4일"
    },
    {
      "start": 303.34,
      "end": 305.56,
      "text": "전에 들어와요."
    },
    {
      "start": 305.56,
      "end": 308.16,
      "text": "그런 거 비교하면 우리가 지금 적응하는 부분에서는"
    },
    {
      "start": 308.16,
      "end": 310.44,
      "text": "압도적으로 위에 있다."
    },
    {
      "start": 310.44,
      "end": 313.16,
      "text": "1차전 또 우리가 승리할 수 있는 하나의 원동력이"
    },
    {
      "start": 313.16,
      "end": 314.92,
      "text": "되지 않을까 생각을 하고 있습니다."
    },
    {
      "start": 314.92,
      "end": 318.08,
      "text": "저는 특히 손흥민 선수의 득점이 정말 반가웠는데요."
    },
    {
      "start": 318.08,
      "end": 319.8,
      "text": "에이징 커보다 골감음이다."
    },
    {
      "start": 319.8,
      "end": 321.32,
      "text": "말들이 많았잖아요."
    },
    {
      "start": 321.32,
      "end": 323.48,
      "text": "평가전이긴 하지만 멀티콜로 우려를 좀"
    },
    {
      "start": 323.48,
      "end": 324.4,
      "text": "지운 것 같아요."
    },
    {
      "start": 324.4,
      "end": 328.4,
      "text": "제 앞서서도 설명을 비슷하게 정회장 사퇴 관련해서"
    },
    {
      "start": 328.4,
      "end": 332.0,
      "text": "했지만 월티컵 기간은 선수들에게 가장 필요한"
    },
    {
      "start": 332.0,
      "end": 336.2,
      "text": "작업 중에 하나가 부담감을 내려놓는 겁니다."
    },
    {
      "start": 336.2,
      "end": 338.32,
      "text": "대표팀 주장이라는 책임감."
    },
    {
      "start": 338.32,
      "end": 340.88,
      "text": "그리고 또 주축 공격수라는 부담감이"
    },
    {
      "start": 340.88,
      "end": 344.28,
      "text": "손흥민 선수한테는 굉장히 집중되고 있던"
    },
    {
      "start": 344.28,
      "end": 346.56,
      "text": "상황이었는데 게다가 또 소속팀에서 최근 한"
    },
    {
      "start": 346.56,
      "end": 350.4,
      "text": "10경기에서 득점이 없었으니까 본인도 솔직히"
    },
    {
      "start": 350.4,
      "end": 354.88,
      "text": "좀 마음적으로 무거운 부분이 있었을 텐데 그"
    },
    {
      "start": 354.88,
      "end": 358.56,
      "text": "응어리를 좀 풀어내는 경고를 됐을 거라고"
    },
    {
      "start": 358.56,
      "end": 359.48,
      "text": "봅니다."
    },
    {
      "start": 359.48,
      "end": 363.56,
      "text": "그런 면에서 아무튼 또 기분 좋게 대표팀을"
    },
    {
      "start": 363.56,
      "end": 366.48,
      "text": "경기를 본선을 준비한다는 점에서는 상당한"
    },
    {
      "start": 366.48,
      "end": 369.2,
      "text": "효과가 있었던 그리고 기다렸던 두 골이었다고"
    },
    {
      "start": 369.2,
      "end": 370.76,
      "text": "생각합니다."
    },
    {
      "start": 370.76,
      "end": 373.64,
      "text": "그리고 또 원톱 자리를 이어 받은 조교성"
    },
    {
      "start": 373.64,
      "end": 377.2,
      "text": "선수도 머리로 또 발로 멀티콜을 터뜨렸습니다."
    },
    {
      "start": 377.2,
      "end": 381.32,
      "text": "월드컵에 남자다운 모습 벌써 기대가 되는데요."
    },
    {
      "start": 381.32,
      "end": 383.6,
      "text": "남자다운 모습이 어떤 모습인지 모르겠는데."
    },
    {
      "start": 383.6,
      "end": 384.8,
      "text": "월드컵에 남자."
    },
    {
      "start": 384.8,
      "end": 385.8,
      "text": "월드컵에 남자."
    },
    {
      "start": 385.8,
      "end": 386.8,
      "text": "네."
    },
    {
      "start": 386.8,
      "end": 387.8,
      "text": "월드컵에 남자."
    },
    {
      "start": 387.8,
      "end": 390.12,
      "text": "조교성 선수 같은 경우는 12월 볼리비아 전"
    },
    {
      "start": 390.12,
      "end": 393.8,
      "text": "이후에 6개월 만에 A매치 골이었고요."
    },
    {
      "start": 393.8,
      "end": 396.88,
      "text": "올 시즌의 개인 득점도 사실 3월이 마지막이었어요."
    },
    {
      "start": 396.88,
      "end": 399.08,
      "text": "그렇기 때문에 이번에 멀티콜은 상당히 고무적인"
    },
    {
      "start": 399.08,
      "end": 400.08,
      "text": "일이고."
    },
    {
      "start": 400.08,
      "end": 405.52,
      "text": "그런데 조교성 선수가 인터뷰해서 볼이 평소보다는"
    },
    {
      "start": 405.52,
      "end": 406.52,
      "text": "상당히 빠르다."
    },
    {
      "start": 406.52,
      "end": 407.52,
      "text": "네."
    },
    {
      "start": 407.52,
      "end": 409.28,
      "text": "그리고 입이 좀 빅짝빅짝 마른다."
    },
    {
      "start": 409.28,
      "end": 411.84,
      "text": "이런 표현도 썼습니다만."
    },
    {
      "start": 411.84,
      "end": 415.28,
      "text": "사실은 이번 월드컵에서 조교성 선수가 이렇게"
    },
    {
      "start": 415.28,
      "end": 416.96,
      "text": "고지대와서 적응."
    },
    {
      "start": 416.96,
      "end": 419.4,
      "text": "크로스 같은 경우도 공기 빠르기 때문에 낙구지전"
    },
    {
      "start": 419.4,
      "end": 421.88,
      "text": "포착하는 게 상당히 중요하다 그래요."
    },
    {
      "start": 421.88,
      "end": 423.36,
      "text": "평상시와는 다르다덥니다."
    },
    {
      "start": 423.36,
      "end": 426.08,
      "text": "그런 부분에서는 조교성 선수가 빠르게 와서 지금"
    },
    {
      "start": 426.08,
      "end": 428.88,
      "text": "적응을 하고 있다는 부분이 우리가 1, 2차전"
    },
    {
      "start": 428.88,
      "end": 430.64,
      "text": "고지대에서 치른 상황에서 상당히 중요할 것"
    },
    {
      "start": 430.64,
      "end": 431.64,
      "text": "같고요."
    },
    {
      "start": 431.64,
      "end": 434.04,
      "text": "특히 1차전 최코전 같은 경우는 키가 큰"
    },
    {
      "start": 434.04,
      "end": 436.04,
      "text": "최코전수들 상대로 피지컬적으로 조교성"
    },
    {
      "start": 436.04,
      "end": 438.68,
      "text": "선수가 필요하고 그런 상황에서 우리 대표팀"
    },
    {
      "start": 438.68,
      "end": 441.64,
      "text": "은 사실 이강인 선수가 합류를 했을 때 이강인"
    },
    {
      "start": 441.64,
      "end": 444.96,
      "text": "선수의 정확한 크로스 전환킥이나 크로스 혹은"
    },
    {
      "start": 444.96,
      "end": 448.8,
      "text": "이제 옌스나 2, 2억으로 만약에 왼쪽 라인이"
    },
    {
      "start": 448.8,
      "end": 452.0,
      "text": "구성이 될 경우에는 왼쪽에서 공격을 가닿"
    },
    {
      "start": 452.0,
      "end": 455.92,
      "text": "했을 때 이기역 선수의 왼반 얼리 크로스도 전체적으로는"
    },
    {
      "start": 455.92,
      "end": 458.12,
      "text": "하나의 공격 옵션이 될 수가 있기 때문에 그"
    },
    {
      "start": 458.12,
      "end": 461.4,
      "text": "상황에서 역시 고지대에서 납구지점을 포착을"
    },
    {
      "start": 461.4,
      "end": 464.04,
      "text": "하는 적응을 빨리 해야 되는 조교성 선수의 역할이"
    },
    {
      "start": 464.04,
      "end": 465.24,
      "text": "매우 중요합니다."
    },
    {
      "start": 465.24,
      "end": 468.6,
      "text": "그런 부분에서 이날 고지대에서 멋진 헤딩"
    },
    {
      "start": 468.6,
      "end": 470.76,
      "text": "골까지 넣었다는 부분 고무적이고요."
    },
    {
      "start": 470.76,
      "end": 473.92,
      "text": "최코전 명화력을 기대하겠습니다."
    },
    {
      "start": 473.92,
      "end": 477.08,
      "text": "그리고 종아리 허벅지 발목까지 계속된 부상에"
    },
    {
      "start": 477.08,
      "end": 479.44,
      "text": "시달렸던 황인범 선수도 무사히 복귀 전을"
    },
    {
      "start": 479.44,
      "end": 480.4,
      "text": "치렀는데요."
    },
    {
      "start": 480.4,
      "end": 481.68,
      "text": "어떻게 보셨어요?"
    },
    {
      "start": 481.68,
      "end": 484.96,
      "text": "우리 대표팀에 들어와 있는 선수들은 사실 모두"
    },
    {
      "start": 484.96,
      "end": 487.48,
      "text": "다 훌륭한 계절향을 갖춘 선수들이죠."
    },
    {
      "start": 487.48,
      "end": 491.04,
      "text": "저는 축구 선수의 첫 번째 기본이 뭐냐고"
    },
    {
      "start": 491.04,
      "end": 494.84,
      "text": "누군가 묻는다면 저는 공을 어떻게 받아 놓느냐"
    },
    {
      "start": 494.84,
      "end": 498.36,
      "text": "아까 첫 번째 터치라고 저는 생각해요."
    },
    {
      "start": 498.36,
      "end": 501.48,
      "text": "그러려면 첫 번째 터치가 좋으려면 주변 상황을"
    },
    {
      "start": 501.48,
      "end": 505.08,
      "text": "끊임없이 파악하고 있어야 되고 또 머릿속에"
    },
    {
      "start": 505.08,
      "end": 507.72,
      "text": "쉴 새 없이 머릿속에서는 쉴 새 없이 상황"
    },
    {
      "start": 507.72,
      "end": 510.56,
      "text": "판단을 하고 있어야 되고 기본기 당연히"
    },
    {
      "start": 510.56,
      "end": 515.0,
      "text": "탄탄해야 되고 물리적 심리적 압박에서 버틸 수 있는"
    },
    {
      "start": 515.0,
      "end": 518.88,
      "text": "강한 신체와 마음이 필수적이거든요."
    },
    {
      "start": 518.88,
      "end": 520.92,
      "text": "이런 부분에서 저는 우리 대표팀에서 최고의"
    },
    {
      "start": 520.92,
      "end": 523.28,
      "text": "두 명 뽑으라고 하면 이강인 선수하고 황인범"
    },
    {
      "start": 523.28,
      "end": 525.44,
      "text": "선수를 꼽겠습니다."
    },
    {
      "start": 525.44,
      "end": 529.76,
      "text": "보기에 참 편안한 선수이고요."
    },
    {
      "start": 529.76,
      "end": 533.56,
      "text": "이번 경기 원터치 패스 같은 것도 보면 경기를"
    },
    {
      "start": 533.56,
      "end": 536.72,
      "text": "하면서 그 순간에 주변 상황들을 굉장히 빠르게"
    },
    {
      "start": 536.72,
      "end": 540.2,
      "text": "스캔하고 있고 공이 오면 내가 어떻게 하겠다는 게"
    },
    {
      "start": 540.2,
      "end": 542.48,
      "text": "미리 계산이 되어 있었던 장면들."
    },
    {
      "start": 542.48,
      "end": 546.12,
      "text": "축구도사 같은 그런 모습들을 황인범 선수가"
    },
    {
      "start": 546.12,
      "end": 550.32,
      "text": "오랫동안 경기장을 떠나 있으면서 보여주지 못했었는데"
    },
    {
      "start": 550.32,
      "end": 554.24,
      "text": "짧은 시간이지만 황인범 선수의 장점을 보기에는"
    },
    {
      "start": 554.24,
      "end": 555.2,
      "text": "충분했다."
    },
    {
      "start": 555.2,
      "end": 556.8,
      "text": "그리고 참 다행이다."
    },
    {
      "start": 556.8,
      "end": 559.88,
      "text": "이 시점에 이런 모습으로 돌아와서 이제 다음"
    },
    {
      "start": 559.88,
      "end": 563.96,
      "text": "경기전 엘살바도를 선에서는 조금 더 많은 시간을"
    },
    {
      "start": 563.96,
      "end": 567.24,
      "text": "통해서 적응력을 조금 더 키울 수 있을 것이고요."
    },
    {
      "start": 567.24,
      "end": 571.88,
      "text": "그렇게 된다면 1차전 또 2차전에서는 충분히"
    },
    {
      "start": 571.88,
      "end": 575.56,
      "text": "정상적인 컨디션으로 경기를 칠 수 있지 않을까"
    },
    {
      "start": 575.56,
      "end": 577.64,
      "text": "그렇게 기대를 할 수 있을 것 같습니다."
    },
    {
      "start": 577.64,
      "end": 580.96,
      "text": "그리고 또 장미연님이 아까 얘기를 해 주셨지만"
    },
    {
      "start": 580.96,
      "end": 583.16,
      "text": "이번 최종 명단에서 가장 화제를 보았던"
    },
    {
      "start": 583.16,
      "end": 585.84,
      "text": "이기혁 선수는 왼쪽 스토퍼로 풀타임을"
    },
    {
      "start": 585.84,
      "end": 586.88,
      "text": "띄웠는데요."
    },
    {
      "start": 586.88,
      "end": 589.32,
      "text": "앤스 카스트로프 선수와의 왼쪽 라인 조합이"
    },
    {
      "start": 589.32,
      "end": 590.52,
      "text": "인상적이었어요."
    },
    {
      "start": 590.52,
      "end": 591.48,
      "text": "그렇습니다."
    },
    {
      "start": 591.48,
      "end": 593.56,
      "text": "스포스토턴을 통해서 지난 번 시간에도"
    },
    {
      "start": 593.56,
      "end": 596.2,
      "text": "말씀을 드렸지만 이기혁 선수가 가세했을 때"
    },
    {
      "start": 596.2,
      "end": 597.04,
      "text": "효과."
    },
    {
      "start": 597.04,
      "end": 600.84,
      "text": "그동안 사실 홍명보의 백스리의 가장 큰 문제."
    },
    {
      "start": 600.84,
      "end": 603.12,
      "text": "역시 경직된 전술 운영이에요."
    },
    {
      "start": 603.12,
      "end": 605.38,
      "text": "그래서 현대 축구의 화두와 좀 맞지 않는"
    },
    {
      "start": 605.38,
      "end": 608.36,
      "text": "백스리의 약간 상당히 경직되어 있고"
    },
    {
      "start": 608.36,
      "end": 611.06,
      "text": "그리고 윙백은 상당히 단조로운 그냥 공격"
    },
    {
      "start": 611.06,
      "end": 613.8,
      "text": "직선적인 가담의 치중하는 형태의 운영에서"
    },
    {
      "start": 613.8,
      "end": 616.28,
      "text": "상대가 대처하기도 쉽고 우리 공격 루트가"
    },
    {
      "start": 616.28,
      "end": 618.5,
      "text": "상당히 단순해지는 그런 이제 걸고가"
    },
    {
      "start": 618.5,
      "end": 619.96,
      "text": "이어졌었는데요."
    },
    {
      "start": 619.96,
      "end": 623.0,
      "text": "그런 부분을 역시 이기혁 선수가 들어가면서"
    },
    {
      "start": 623.0,
      "end": 625.76,
      "text": "전술적 유연성을 확보하는 역할."
    },
    {
      "start": 625.76,
      "end": 627.68,
      "text": "이것이 이제 이기혁 선수에게는 과제였는데"
    },
    {
      "start": 627.68,
      "end": 630.2,
      "text": "지금 왼발 롱킥이 있지만 이기혁 선수는"
    },
    {
      "start": 630.2,
      "end": 632.0,
      "text": "왼발 롱킥이 정확하고요."
    },
    {
      "start": 632.0,
      "end": 635.74,
      "text": "공격 시에는 이날도 홍명보 감독이 수비할 땐"
    },
    {
      "start": 635.74,
      "end": 639.2,
      "text": "백스리지만 공격 시에는 백4로 전환이 되면서"
    },
    {
      "start": 639.2,
      "end": 642.28,
      "text": "왼쪽 4백의 수비수로 공격 가담을 이기혁 선수가"
    },
    {
      "start": 642.28,
      "end": 643.92,
      "text": "많이 올라와서 했습니다."
    },
    {
      "start": 643.92,
      "end": 646.4,
      "text": "그리고 옌스 선수는 왼쪽 윙백이지만 오히려"
    },
    {
      "start": 646.4,
      "end": 649.72,
      "text": "윙어 같은 역할을 하면서 배준호 선수가 중앙으로"
    },
    {
      "start": 649.72,
      "end": 652.32,
      "text": "이동하면서 공격형 이틀드 역할을 맞는 이러한"
    },
    {
      "start": 652.32,
      "end": 655.92,
      "text": "이른바 하이브레이드 운영을 위연하게 잘 가져가면서"
    },
    {
      "start": 655.92,
      "end": 657.2,
      "text": "경균형이 됐고요."
    },
    {
      "start": 657.2,
      "end": 660.64,
      "text": "그것을 이기혁 선수가 제가 볼 땐 거의 90% 100%"
    },
    {
      "start": 660.64,
      "end": 662.7,
      "text": "이상 잘 소화했다고 생각이 듭니다."
    },
    {
      "start": 662.7,
      "end": 665.48,
      "text": "그렇기 때문에 원래 이렇게 오랜만에 대표팀에"
    },
    {
      "start": 665.48,
      "end": 668.32,
      "text": "갔을 때 그것도 본선을 앞두고 지금 발탁이"
    },
    {
      "start": 668.32,
      "end": 671.84,
      "text": "됐기 때문에 좀 긴장을 할 법도 한데 제가 평상시에"
    },
    {
      "start": 671.84,
      "end": 674.48,
      "text": "이기혁 선수 성격을 보면 상대를 대범해요."
    },
    {
      "start": 674.48,
      "end": 677.04,
      "text": "그렇기 때문에 본인 실력을 그냥 유감없이 잘"
    },
    {
      "start": 677.04,
      "end": 680.84,
      "text": "발릴 냈고 옌스도 이날 많은 활동량 또"
    },
    {
      "start": 680.84,
      "end": 683.64,
      "text": "순간적인 카운터 프레싱 또 여러 가지 움직임을"
    },
    {
      "start": 683.64,
      "end": 686.56,
      "text": "통한 수비 교단에 있어서 상당히 좋은 모습을"
    },
    {
      "start": 686.56,
      "end": 690.56,
      "text": "보였기 때문에 저는 이 왼쪽 라인이 조금 더"
    },
    {
      "start": 690.56,
      "end": 693.6,
      "text": "살아줘서 본선에서 활용이 된다면 홍변모"
    },
    {
      "start": 693.6,
      "end": 696.52,
      "text": "감독이 가지고 있던 그동안의 약간의 전술적"
    },
    {
      "start": 696.52,
      "end": 700.48,
      "text": "경직성을 탈피시켜서 상당히 좋은 팀으로"
    },
    {
      "start": 700.48,
      "end": 703.0,
      "text": "급반전할 수 있는 계기는 분명히 있다."
    },
    {
      "start": 703.0,
      "end": 705.36,
      "text": "그런 부분에서 매우 고무적인 그런 결과였다고"
    },
    {
      "start": 705.36,
      "end": 706.36,
      "text": "생각을 합니다."
    },
    {
      "start": 706.36,
      "end": 709.28,
      "text": "이기혁 선수 마지막에 막판에는 말쇠유턴도"
    },
    {
      "start": 709.28,
      "end": 710.28,
      "text": "하고 있더라고요."
    },
    {
      "start": 710.28,
      "end": 713.76,
      "text": "그래서 뒷 얘기를 좀 물어봤었는데 자신 있어서"
    },
    {
      "start": 713.76,
      "end": 717.28,
      "text": "했다고 하고 감독님한테는 좀 지적을 받았다고"
    },
    {
      "start": 717.28,
      "end": 718.28,
      "text": "해요."
    },
    {
      "start": 718.28,
      "end": 721.24,
      "text": "그러니까 이게 상대가 지금 약체니까 사실 그런"
    },
    {
      "start": 721.24,
      "end": 725.0,
      "text": "동작을 해도 큰 무리가 없었지만 월드컵에서는"
    },
    {
      "start": 725.0,
      "end": 729.2,
      "text": "훨씬 더 강한 상대들이 압박해 들어오는데 거기서"
    },
    {
      "start": 729.2,
      "end": 733.2,
      "text": "자칫 그런 걸 보여주려다가 실수를 하게 되면"
    },
    {
      "start": 733.2,
      "end": 735.0,
      "text": "팀에는 당연히 마이너스고요."
    },
    {
      "start": 735.0,
      "end": 737.72,
      "text": "그리고 앞에서 그걸 보는 공격수들이 좀 불안해"
    },
    {
      "start": 737.72,
      "end": 738.72,
      "text": "할 수 있다."
    },
    {
      "start": 738.72,
      "end": 742.4,
      "text": "그러니까 쉽게 처리할 수 있는 거는 보다 단순하게"
    },
    {
      "start": 742.4,
      "end": 744.68,
      "text": "처리하라는 주문을 했다고 해요."
    },
    {
      "start": 744.68,
      "end": 748.56,
      "text": "이기혁 선수가 그런 모습을 보여주는 건 저는 팩"
    },
    {
      "start": 748.56,
      "end": 751.2,
      "text": "이로써 되게 높게 평가합니다."
    },
    {
      "start": 751.2,
      "end": 754.52,
      "text": "이렇게 또 좋은 소식만 들려드리면 좋으렷만"
    },
    {
      "start": 754.52,
      "end": 756.88,
      "text": "많은 수학 속에 큰 위기도 발생 했습니다."
    },
    {
      "start": 756.88,
      "end": 759.52,
      "text": "조유미 선수가 이 경기에서 부상을 입으면서"
    },
    {
      "start": 759.52,
      "end": 761.92,
      "text": "결국에는 본선에 나서지 못하게 됐어요."
    },
    {
      "start": 761.92,
      "end": 765.4,
      "text": "경기 중에 오른쪽 발바닥의 통증을 좀"
    },
    {
      "start": 765.4,
      "end": 766.4,
      "text": "느낀 것 같아요."
    },
    {
      "start": 766.4,
      "end": 769.4,
      "text": "진단해 보니까 족적음막이라고 하죠."
    },
    {
      "start": 769.4,
      "end": 774.16,
      "text": "그래서 발바닥의 근육이 좀 파열이 돼서 전치 8주."
    },
    {
      "start": 774.16,
      "end": 776.92,
      "text": "그러니까 8주 정도 쉬고 치료를 해야 된다라는"
    },
    {
      "start": 776.92,
      "end": 778.16,
      "text": "진단을 받게 됐습니다."
    },
    {
      "start": 778.16,
      "end": 782.36,
      "text": "결국 이번 월드컵은 뛸 수 없게 됐습니다."
    },
    {
      "start": 782.36,
      "end": 785.04,
      "text": "후렴 파트너로 동행했던 조이제 선수가 그래서"
    },
    {
      "start": 785.04,
      "end": 787.6,
      "text": "현지에서 대체 발탁이 됐고요."
    },
    {
      "start": 787.6,
      "end": 792.96,
      "text": "또 부상 위험이 제일 경기해야 될 부분인데"
    },
    {
      "start": 792.96,
      "end": 796.68,
      "text": "어제 또 경기에서 배준호 선수가 다쳐서"
    },
    {
      "start": 796.68,
      "end": 798.48,
      "text": "교치되는 장면이 있었거든요."
    },
    {
      "start": 798.48,
      "end": 800.8,
      "text": "배준호 선수는 조금 더 상황을 지켜봐야 된다고"
    },
    {
      "start": 800.8,
      "end": 801.8,
      "text": "합니다."
    },
    {
      "start": 801.8,
      "end": 802.8,
      "text": "그렇습니다."
    },
    {
      "start": 802.8,
      "end": 804.12,
      "text": "정말 안타까운 부분이 있죠."
    },
    {
      "start": 804.12,
      "end": 806.68,
      "text": "조유미 선수가 지난번 평가하자 한 때 약간의"
    },
    {
      "start": 806.68,
      "end": 809.32,
      "text": "실책성 플레이들이 있었기 때문에 약간의"
    },
    {
      "start": 809.32,
      "end": 812.8,
      "text": "비난을 또 감소한 채 이번에 명단에 뽑혔었고"
    },
    {
      "start": 812.8,
      "end": 814.92,
      "text": "이번에 뭔가 보여주고 싶었던 것도 강했던 것"
    },
    {
      "start": 814.92,
      "end": 815.92,
      "text": "같아요."
    },
    {
      "start": 815.92,
      "end": 818.6,
      "text": "그래서 좀 강한 돌파를 통해서 뭔가 개인적인"
    },
    {
      "start": 818.6,
      "end": 820.44,
      "text": "퍼포먼스도 보여주고 싶어 했던 것 같은데"
    },
    {
      "start": 820.44,
      "end": 822.8,
      "text": "거기서 또 약간 미스도 나왔었어요."
    },
    {
      "start": 822.8,
      "end": 825.44,
      "text": "그런 상황에서 또 부상을 당했습니다."
    },
    {
      "start": 825.44,
      "end": 828.08,
      "text": "그래서 개인적으로는 이번 월드컵에 나가고"
    },
    {
      "start": 828.08,
      "end": 830.48,
      "text": "싶은 어떤 동기부여나 이런 부분이 상당히 강했던"
    },
    {
      "start": 830.48,
      "end": 833.52,
      "text": "선수였고 평상시에 또 인성도 상당히 좋은"
    },
    {
      "start": 833.52,
      "end": 834.52,
      "text": "선수입니다."
    },
    {
      "start": 834.52,
      "end": 836.8,
      "text": "그렇게 부분에서 정말 안타까운 부분이고요."
    },
    {
      "start": 836.8,
      "end": 839.4,
      "text": "그리고 대체 발탁 조이제 선수가 됐는데 역시"
    },
    {
      "start": 839.4,
      "end": 841.6,
      "text": "우리가 지난번 방송에서도 말씀드렸습니다만"
    },
    {
      "start": 841.6,
      "end": 845.44,
      "text": "이 훈련 판타는으로 간 선수들 중에서 강상윤"
    },
    {
      "start": 845.44,
      "end": 847.84,
      "text": "선수나 윤기우 키퍼 같은 경우는 나이가"
    },
    {
      "start": 847.84,
      "end": 848.84,
      "text": "어린 게 맞고요."
    },
    {
      "start": 848.84,
      "end": 850.52,
      "text": "그런데 이 선수는 경험을 좀 싹게 하는"
    },
    {
      "start": 850.52,
      "end": 852.8,
      "text": "차원도 강합니다만 조이제 선수는 지난번"
    },
    {
      "start": 852.8,
      "end": 855.24,
      "text": "말씀드린 대로 나이가 어린 선수는 아닙니다"
    },
    {
      "start": 856.16,
      "end": 859.26,
      "text": "그렇기 때문에 만약에 최종 엔트리 를"
    },
    {
      "start": 859.26,
      "end": 863.4,
      "text": "제출하는 6월 초 벌써 오늘 내일 하겠죠."
    },
    {
      "start": 863.4,
      "end": 867.2,
      "text": "제출을 하기 전에 평가전이나 훈련 중에"
    },
    {
      "start": 867.2,
      "end": 869.5,
      "text": "얘기치 않은 부상자가 발생이 됐을 경우 특히"
    },
    {
      "start": 869.5,
      "end": 871.94,
      "text": "수비 쪽에서 발생이 됐을 경우 조이제 선수가"
    },
    {
      "start": 871.94,
      "end": 874.76,
      "text": "대체 발탁할 수가 있다."
    },
    {
      "start": 874.76,
      "end": 876.56,
      "text": "아마 그런 차원에서 데려간 부분도 있다라는"
    },
    {
      "start": 876.56,
      "end": 878.96,
      "text": "말씀을 드렸는데 이번에 실제로 그렇게"
    },
    {
      "start": 878.96,
      "end": 879.96,
      "text": "돼버렸어요."
    },
    {
      "start": 879.96,
      "end": 882.0,
      "text": "그래서 조이제 선수에게는 정말 안타까운"
    },
    {
      "start": 882.0,
      "end": 884.36,
      "text": "부분이지만 결국 조이제 선수가 발탁이"
    },
    {
      "start": 884.36,
      "end": 888.28,
      "text": "되면서 결국은 기존 수비 진화하고 빨리"
    },
    {
      "start": 888.28,
      "end": 891.4,
      "text": "호흡을 끌어올리는 게 조직을 또 올리는 게"
    },
    {
      "start": 891.4,
      "end": 892.96,
      "text": "급선무와 됐습니다."
    },
    {
      "start": 892.96,
      "end": 895.72,
      "text": "우리 대표팀은 이제 4월 오전 10시에 엘살바도르"
    },
    {
      "start": 895.72,
      "end": 897.24,
      "text": "와 평가전을 치립니다."
    },
    {
      "start": 897.24,
      "end": 900.24,
      "text": "월드컵전 마지막 평가전인 만큼 어떤 점을 더"
    },
    {
      "start": 900.24,
      "end": 901.8,
      "text": "점검하면 좋을까요."
    },
    {
      "start": 901.8,
      "end": 904.6,
      "text": "일단은 지난 트리네드 토바구 오전 같은 경우는"
    },
    {
      "start": 904.6,
      "end": 906.64,
      "text": "이강의 선수가 웹화 챔피언스레오 결승전"
    },
    {
      "start": 906.64,
      "end": 908.64,
      "text": "때문에 합류할 수 없었어요."
    },
    {
      "start": 908.64,
      "end": 910.76,
      "text": "이강의 선수는 역시 본선의 선수는 중요한"
    },
    {
      "start": 910.76,
      "end": 913.64,
      "text": "선수고 이번에 엘살바도르 전은 이강의 선수가"
    },
    {
      "start": 913.64,
      "end": 916.28,
      "text": "합류해서 또 김민재사 같은 선수들이 이제"
    },
    {
      "start": 916.28,
      "end": 920.4,
      "text": "선발로 들어오면서 진짜 최코전 대비에서"
    },
    {
      "start": 920.4,
      "end": 923.84,
      "text": "베스트 멤버를 한번 맞춰보는 단계 또"
    },
    {
      "start": 923.84,
      "end": 926.08,
      "text": "고지대에서의 이 선수들을 완벽하게 베스트"
    },
    {
      "start": 926.08,
      "end": 928.28,
      "text": "레브로 적응시키는 단계에서의 경기가"
    },
    {
      "start": 928.28,
      "end": 930.92,
      "text": "돼야 될 것 같고 물론 상대 엘살바도르도"
    },
    {
      "start": 930.92,
      "end": 933.24,
      "text": "트리네드 토바구 것처럼 약챕니다."
    },
    {
      "start": 933.24,
      "end": 936.64,
      "text": "그렇더라도 이제 우리 선수들 우리 거가 일단은"
    },
    {
      "start": 936.64,
      "end": 939.68,
      "text": "좀 준비될 수 있는 그런 경기력이 필요하기"
    },
    {
      "start": 939.68,
      "end": 943.16,
      "text": "때문에 역시 그런 부분에서 선의 중요한"
    },
    {
      "start": 943.16,
      "end": 946.88,
      "text": "경기고 이 기억이나 엔스를 일정 시간 한"
    },
    {
      "start": 946.88,
      "end": 948.72,
      "text": "번도 볼 것 같습니다."
    },
    {
      "start": 948.72,
      "end": 951.2,
      "text": "그 상황에서 역시 전체적인 1, 2차전"
    },
    {
      "start": 951.2,
      "end": 954.0,
      "text": "게임 플랜을 짜는데 있어서 가장 중요한 경기"
    },
    {
      "start": 954.0,
      "end": 957.0,
      "text": "잘 마무리하고 기분 좋게 또 대승을 거둬서"
    },
    {
      "start": 957.0,
      "end": 959.56,
      "text": "자신감을 갖고 물론 이제 본선에 나오는 팀하고"
    },
    {
      "start": 959.56,
      "end": 962.84,
      "text": "레벨이 완전히 다른 두 팀하고 경기였겠지만"
    },
    {
      "start": 962.84,
      "end": 965.12,
      "text": "어쨌든 자신감을 갖고 1차전을 할 수 있도록"
    },
    {
      "start": 965.12,
      "end": 967.48,
      "text": "그렇게 노력을 했으면 좋겠습니다."
    },
    {
      "start": 967.48,
      "end": 968.48,
      "text": "정찬 기자님은요."
    },
    {
      "start": 968.48,
      "end": 970.92,
      "text": "앞서도 말씀드렸지만 저는 컨디션닝의"
    },
    {
      "start": 970.92,
      "end": 972.6,
      "text": "일환일 거라고 생각이 들어요."
    },
    {
      "start": 972.6,
      "end": 976.8,
      "text": "말씀드려 주신대로 장연님께서 말씀해 주신대로"
    },
    {
      "start": 976.8,
      "end": 979.84,
      "text": "이제 첫 번째 경기 트리네드 토바구와 경기에서"
    },
    {
      "start": 979.84,
      "end": 982.28,
      "text": "시간을 좀 많이 못 받았던 선수들은 조금 더"
    },
    {
      "start": 982.28,
      "end": 983.56,
      "text": "시간을 받을 거고요."
    },
    {
      "start": 983.56,
      "end": 986.2,
      "text": "그리고 지금 대표팀이 고지대에서 훈련을 하면서"
    },
    {
      "start": 986.2,
      "end": 991.24,
      "text": "매일 하루에 수차례씩 선수들의 산소포화도"
    },
    {
      "start": 991.24,
      "end": 993.76,
      "text": "그리고 또 피로도를 과학적으로 지금 보고"
    },
    {
      "start": 993.76,
      "end": 994.44,
      "text": "있어요."
    },
    {
      "start": 994.44,
      "end": 998.04,
      "text": "그 데이터를 갖고 선수들의 훈련 출전 시간을"
    },
    {
      "start": 998.04,
      "end": 999.76,
      "text": "조율하고 있는 거거든요."
    },
    {
      "start": 999.76,
      "end": 1002.68,
      "text": "그런 점에서 결국에 우리가 제일 중요한 건"
    },
    {
      "start": 1002.68,
      "end": 1004.92,
      "text": "과달라하라에서 있는 1차전이니까요."
    },
    {
      "start": 1004.92,
      "end": 1007.92,
      "text": "그 1차전에 맞춰서 어떤 빌드업을 갖고 갈"
    },
    {
      "start": 1007.92,
      "end": 1008.64,
      "text": "것이냐."
    },
    {
      "start": 1008.64,
      "end": 1011.56,
      "text": "선수 개개인별로 고지대에 적응하는 속도"
    },
    {
      "start": 1011.56,
      "end": 1014.56,
      "text": "그리고 피로도가 다 다르기 때문에 선수들이"
    },
    {
      "start": 1014.56,
      "end": 1018.2,
      "text": "합류한 시점도 다르고 그리고 또 포지션에"
    },
    {
      "start": 1018.2,
      "end": 1020.48,
      "text": "따라서 또 중요한 부분 그리고 과거에 부상이"
    },
    {
      "start": 1020.48,
      "end": 1023.28,
      "text": "있었는지 없었는지도 중요한 부분이라서 그런"
    },
    {
      "start": 1023.28,
      "end": 1025.92,
      "text": "부분에 맞게 개인적인 컨디션닝이 제일"
    },
    {
      "start": 1025.92,
      "end": 1029.52,
      "text": "중요한 부분일 거라고 생각을 하고요."
    },
    {
      "start": 1029.52,
      "end": 1031.96,
      "text": "황인범 선수처럼 조금 더 시간을 늘려가면서"
    },
    {
      "start": 1031.96,
      "end": 1035.52,
      "text": "경기감각을 깨워야 하는 선수들도 있을 테고"
    },
    {
      "start": 1035.52,
      "end": 1037.6,
      "text": "더 중요한 거는 다치지 않는 겁니다."
    },
    {
      "start": 1037.6,
      "end": 1038.32,
      "text": "그럼요."
    },
    {
      "start": 1038.32,
      "end": 1042.12,
      "text": "지금 월드컵이 진짜 눈앞이고 4년을 또"
    },
    {
      "start": 1042.12,
      "end": 1044.76,
      "text": "길게는 평생을 꿈꿔온 선수들의 꿈의 무대가"
    },
    {
      "start": 1044.76,
      "end": 1047.36,
      "text": "바로 눈앞이 있기 때문에 우리 선수들이 다치지"
    },
    {
      "start": 1047.36,
      "end": 1050.72,
      "text": "않고 정상적인 컨디션에서 최상의 기량을"
    },
    {
      "start": 1050.72,
      "end": 1053.68,
      "text": "발휘할 수 있는 상태로 과달라라로 이동할 수"
    },
    {
      "start": 1053.68,
      "end": 1054.88,
      "text": "있었으면 좋겠습니다."
    },
    {
      "start": 1054.88,
      "end": 1055.4,
      "text": "네."
    },
    {
      "start": 1055.4,
      "end": 1057.88,
      "text": "호명보호가 기분 좋게 월드컵 본선 무대로"
    },
    {
      "start": 1057.88,
      "end": 1060.64,
      "text": "향할 수 있기를 바라면서 두 분과는 여기서"
    },
    {
      "start": 1060.64,
      "end": 1061.4,
      "text": "인사드리겠습니다."
    },
    {
      "start": 1061.4,
      "end": 1062.2,
      "text": "고맙습니다."
    },
    {
      "start": 1062.2,
      "end": 1063.2,
      "text": "감사합니다."
    },
    {
      "start": 1063.2,
      "end": 1064.2,
      "text": "감사합니다."
    }
  ]
}