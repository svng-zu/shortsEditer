# AWS 설정 (IAM Role 사용시 키 불필요)
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=aishortsbucket

# Gemini 설정
GEMINI_API_KEY=your_gemini_api_key

# TTS: Google Cloud Text-to-Speech (서비스 계정 키 파일 경로, 비워두면
# backend/app/credentials/gcp_tts_key.json 기본값 사용)
GCP_TTS_CREDENTIALS=

# YouTube OAuth2 (Google Cloud Console에서 발급)
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# OAuth 2.0 클라이언트 ID (웹 애플리케이션) → 승인된 리디렉션 URI: http://YOUR_EC2_IP/api/youtube/callback
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REDIRECT_URI=http://43.203.53.134/api/youtube/callback

# 사용자 계정 DB (PostgreSQL — docker-compose의 postgres 서비스)
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg2://shortsai:change_me@postgres:5432/shortsai

# JWT 인증 (openssl rand -hex 32 로 생성)
JWT_SECRET_KEY=change_me_to_a_random_secret

# 사용자 로그인용 Google OAuth2 (YouTube 업로드 OAuth와는 별도 클라이언트로 발급 권장)
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# OAuth 2.0 클라이언트 ID (웹 애플리케이션) → 승인된 리디렉션 URI: http://YOUR_EC2_IP/api/auth/google/callback
# 승인된 자바스크립트 원본에 프런트엔드 도메인 추가, OAuth 동의 화면 스코프: openid, email, profile
GOOGLE_AUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your_client_secret
GOOGLE_AUTH_REDIRECT_URI=http://43.203.53.134/api/auth/google/callback

# 비밀번호 재설정 메일 (AWS SES)
# SES 콘솔에서 발신 이메일(또는 도메인) 인증 필요. 샌드박스 모드면 수신 이메일도 인증 필요
# https://ap-northeast-2.console.aws.amazon.com/ses/home → Verified identities
FRONTEND_URL=https://gorilai.duckdns.org
SES_SENDER_EMAIL=noreply@yourdomain.com

# Whisper 설정
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto

# 앱 설정
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://43.203.53.134"]
