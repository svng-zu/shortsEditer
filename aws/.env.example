# AWS 설정 (IAM Role 사용시 키 불필요)
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=aishortsbucket

# Gemini 설정
GEMINI_API_KEY=your_gemini_api_key

# YouTube OAuth2 (Google Cloud Console에서 발급)
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# OAuth 2.0 클라이언트 ID (웹 애플리케이션) → 승인된 리디렉션 URI: http://YOUR_EC2_IP/api/youtube/callback
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REDIRECT_URI=http://43.203.53.134/api/youtube/callback

# Whisper 설정
WHISPER_MODEL=small
WHISPER_LANGUAGE=ko

# 앱 설정
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://43.203.53.134"]
