# 이 파일을 terraform.tfvars로 복사 후 값 채우기
# cp terraform.tfvars.example terraform.tfvars

aws_region        = "ap-northeast-2"
project_name      = "shortsai"
environment       = "prod"

# AWS 콘솔 > EC2 > 키 페어에서 미리 생성한 키 이름
ec2_key_name      = "your-key-pair-name"

# t3.medium: 2vCPU 4GB (Whisper small/medium 사용 가능)
# t3.large:  2vCPU 8GB (Whisper large 사용 가능)
ec2_instance_type = "t3.medium"

root_volume_size  = 50

# S3 버킷 이름 (전 세계 고유해야 함)
s3_bucket_name    = "aishortsbucket"

# GitHub 저장소 URL
github_repo_url   = "https://github.com/YOUR_USERNAME/shortsEditer.git"

# SSH 허용 IP (0.0.0.0/0 = 전체 허용, 보안상 본인 IP 권장: "x.x.x.x/32")
allowed_ssh_cidr  = "0.0.0.0/0"
